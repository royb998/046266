VA_MATERIALISE:
    VA_ARG LPAREN TYPE COMMA EXP RPAREN
    {
        #if DEBUG_PARSER
        cerr << "VA_MATERIALISE: VA_ARG LPAREN TYPE COMMA EXP RPAREN" << endl;
        #endif

        // Mark basic parser fields
        $$.quad  = buffer->nextQuad();
        $$.type  = $3.type;  
        $$.RegNum = currentScopeRegsNum++;
        string currentFunctionName = $$.name;
        Function& func = functionTable[currentFunctionName];

        //need to set in DEC\DEF: startIndexVAParams = -1 if not variadac

        // Ensure we are indeed inside a variadic function
        if (func.startIndexVAParams == -1) {
            printSemanticError("va_arg used outside of a variadic function");
        }

        // Find the name of the n param (count) in the current function
        string countParamName = func.paramIds.back();
        
        // Lookup that param in the symbol table to get offset
        if (symbolTable.find(countParamName) == symbolTable.end()) {
            printSemanticError("count param '" + countParamName + "' not found in symbol table");
        }
        Symbol& symN = symbolTable[countParamName];
        int offsetOfN = symN.offset[symN.depth];

        // Load n (the number of variadic arguments)
        int nReg = currentScopeRegsNum++;
        buffer->emit("LOADI I" + to_string(nReg) + " I1 " + to_string(offsetOfN));

        // Check index >= 0
        int indexReg = $5.RegNum;
        int tempReg1 = currentScopeRegsNum++;
        buffer->emit("SLETI I" + to_string(tempReg1) + " I" + to_string(indexReg) + " 0");
        int errorBranch1 = buffer->nextQuad();
        // backpatch target => runtime error 
        buffer->emit("BREQZ I" + to_string(tempReg1) + " "); 

        // Check index < n
        int tempReg2 = currentScopeRegsNum++;
        // set if (index >= n) => error
        buffer->emit("SGRTI I" + to_string(tempReg2) + " I" + to_string(indexReg)
                     + " I" + to_string(nReg));
        int errorBranch2 = buffer->nextQuad();
        // => runtime error if index >= n
        buffer->emit("BNEQZ I" + to_string(tempReg2) + " "); 

        // Compute address of argument: "base = (I1 + offsetOfN) + 4" + index * 4
        int baseReg   = currentScopeRegsNum++;  // Store the start of optional params
        int finalAddr = currentScopeRegsNum++;  // The final address

        // base = I1 + offsetOfN
        buffer->emit("ADD2I I" + to_string(baseReg) 
                     + " I1 " + to_string(offsetOfN));

        // base = base + 4  (skip the count param itself)
        buffer->emit("ADD2I I" + to_string(baseReg) 
                     + " I" + to_string(baseReg) + " 4");

        // multiply index * 4
        int indexOffsetReg = currentScopeRegsNum++;
        buffer->emit("MULTI I" + to_string(indexOffsetReg)
                     + " I" + to_string(indexReg) + " 4");

        // finalAddr = base + indexOffset
        buffer->emit("ADD2I I" + to_string(finalAddr)
                     + " I" + to_string(baseReg)
                     + " I" + to_string(indexOffsetReg));

        // 7) Load the argument (int or float)
        string loadType = ($3.type == float_) ? "F" : "I";
        buffer->emit("LOAD" + loadType + " " + loadType + to_string($$ .RegNum)
                     + " I" + to_string(finalAddr) + " 0");

        // Set up a short runtime-error - print "Runtime error!\n" and HALT.
        int runtimeErrorLine = buffer->nextQuad();
        buffer->emit("PRNTC 82");  // 'R'
        buffer->emit("PRNTC 117"); // 'u'
        buffer->emit("PRNTC 110"); // 'n'
        buffer->emit("PRNTC 116"); // 't'
        buffer->emit("PRNTC 105"); // 'i'
        buffer->emit("PRNTC 109"); // 'm'
        buffer->emit("PRNTC 101"); // 'e'
        buffer->emit("PRNTC 32");  // ' '
        buffer->emit("PRNTC 101"); // 'e'
        buffer->emit("PRNTC 114"); // 'r'
        buffer->emit("PRNTC 114"); // 'r'
        buffer->emit("PRNTC 111"); // 'o'
        buffer->emit("PRNTC 114"); // 'r'
        buffer->emit("PRNTC 33");  // '!'
        buffer->emit("PRNTC 10");  // newline
        buffer->emit("HALT");

        // Backpatch those two error branches to jump to runtimeErrorLine
        vector<int> errorBranches;
        errorBranches.push_back(errorBranch1);
        errorBranches.push_back(errorBranch2);
        buffer->backpatch(errorBranches, runtimeErrorLine);
    }
;

