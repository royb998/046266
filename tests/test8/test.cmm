float test(n:int, ...) {
    i: int;
    sum: float;
    i = 0;
    sum = 0.0;
    while i < n do {
        sum = sum + va_arg(float, i);
        i = i + 1;
    }
    return sum;
}

void main() {
    a, b, c, res: float;
    read(a);
    read(b);
    read(c);
    res = test(3, a, b, c);
    write(res);
}
