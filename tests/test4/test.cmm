int test(a, b, c: int) {
    x: int;
    if ((a > b) || (b >= c)) then
        x = c;
    else
        x = a;
    
    if ((x < 5) && (a <= c)) then
        x = 5;
    
    return x;
}

void main() {
    a, b, c, res: int;
    read(a);
    read(b);
    read(c);
    res = test(a, b, c);
    write(res);
}
