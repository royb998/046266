%{

#include <iostream>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <vector>
#include <string>
#include <map>
#include "part3_helpers.hpp" 

#define DEBUG_PARSER 1

#ifdef __cplusplus
extern "C" {
#endif

#if defined(FLEX_SCANNER) || defined(FLEXPP_SCANNER)
extern int yylex_destroy(void);
#else
#define yylex_destroy() (0)
#endif

#ifdef __cplusplus
}
#endif

int printOperationalError (string err);
int printSemanticError(string err);

typedef yystype YYSTYPE;  
extern int yylineno;
extern char* yytext;
int yylex(void);
void yyerror(const char *s);

// Global variables
extern Buffer* buffer;
extern map<string, Symbol> symbolTable;
extern map<string, Function> functionTable;
int currentScopeRegsNum = 3;
int currentScopeOffset = 0;
Type currentReturnType;
bool inVariadicFunction = false;
//static string currentFunctionName = "";

//ParserNode *parseTree = NULL;

%}

/*%union {
    yystype yystype;  // Use the struct isDefined in part3_helpers.hpp
}*/

/* Keywords and operators */
%token  INT FLOAT VOID
%token  RETURN WRITE READ
%token  WHILE IF THEN ELSE DO
%token  ASSIGN VA_ARG ELLIPSIS 
%token  OR AND NOT
%token  ID INTEGERNUM REALNUM STRING_LITERAL RELOP ADDOP MULOP
%token  COMMA SEMICOLON LPAREN RPAREN LBRACE RBRACE COLON

/* Operator precedence and associativity */
%right ASSIGN
%right IF THEN ELSE
%left OR
%left AND
%left RELOP
%left ADDOP
%left MULOP
%right NOT
%left LPAREN
%left RPAREN
%left LBRACE
%left RBRACE
%left COLON
%left SEMICOLON

/* Non-terminal types 
%type  PROGRAM FDEFS FUNC_DEC_API FUNC_DEF_API FUNC_ARGLIST
%type  DCL STLIST STMT ASSN_STMT LVAL CNTRL_STMT
%type  BEXP EXP CALL CALL_ARGS CALL_ARGLIST
%type  NUM VA_MATERIALISE BLK RETURN_STMT WRITE_STMT READ_STMT TYPE
%type  M N
%start PROGRAM*/

%%

PROGRAM:  
    FDEFS
    {
        #if DEBUG_PARSER
        cerr << "PROGRAM: Finished parsing FDEFS." << endl;
        #endif
        // Backpatch function calls
        for(auto& func : functionTable) {
            buffer->backpatch(func.second.callingLines, func.second.startLineImplementation);
        }
        
        // Add HALT AFTER all functions
        //buffer->emit("HALT"); 
    }
    ;

FDEFS:    
    FDEFS FUNC_DEF_API BLK 
    {
        #if DEBUG_PARSER
        cerr << "FDEFS: FDEFS FUNC_DEF_API BLK" << endl;
        #endif
        // Backpatch function calls
        for(auto& func : functionTable) {
            buffer->backpatch(func.second.callingLines, func.second.startLineImplementation);
        }
        
        // Emit RETRN at the end of the function
        buffer->emit("RETRN");

		// Initialize the relevant globals 
		currentScopeRegsNum = 3;
		currentScopeOffset = 0;
		symbolTable.clear();
		$2.paramTypes.clear();
        inVariadicFunction = false;
        $3.name = $2.name; //needed for VA_MATERIALISE
    }
    | FDEFS FUNC_DEC_API
    {
        #if DEBUG_PARSER
        cerr << "FDEFS: FDEFS FUNC_DEC_API" << endl;
        #endif
		if (functionTable[$2.name].startLineImplementation != -1) {
			printSemanticError("function '" + $2.name + "' already isDefined");
		}
        functionTable[$2.name].startLineImplementation = -1;
        functionTable[$2.name].callingLines.clear();
        symbolTable.clear();
    }
    | /* empty */ { }
    ;
    
FUNC_DEC_API:
    TYPE ID LPAREN RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN RPAREN SEMICOLON" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.quad = buffer->nextQuad();

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" + $2.name + "'");
            }
            if (!existingFunc.paramTypes.empty()) {
                printSemanticError("conflicting parameter types for function declaration '" + $2.name + "'");
            }
        } else {
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.startLineImplementation = -1;
            newFunc.isDefined = false; // Mark as NOT isDefined for declaration
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    | TYPE ID LPAREN M FUNC_ARGLIST RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN M FUNC_ARGLIST RPAREN SEMICOLON" << endl;
        for (size_t i = 0; i < $4.paramTypes.size(); ++i) {
            cerr << "    Arg " << i << ": " << $4.paramIds[i] << " (type " << $4.paramTypes[i] << ")" << endl; 
        }
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" + $2.name + "'");
            }
            if (existingFunc.paramTypes != $4.paramTypes) {
                printSemanticError("conflicting parameter types for function declaration '" + $2.name + "'");
            }
        } else {
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.startLineImplementation = -1;
            newFunc.isDefined = false; // Mark as NOT isDefined for declaration
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    | TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN SEMICOLON" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for variadic function declaration '" + $2.name + "'");
            }
            if (existingFunc.paramTypes != $4.paramTypes) {
                printSemanticError("conflicting parameter types for variadic function declaration '" + $2.name + "'");
            }
            if ($4.paramTypes.empty() || $4.paramTypes.back() != int_) {
                printSemanticError("missing or non-int last named parameter before '...'");
            }

        } else {
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.startLineImplementation = -1;
            newFunc.isDefined = false; // Mark as NOT isDefined for declaration
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    ;

FUNC_DEF_API:
    TYPE ID LPAREN RPAREN
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN RPAREN" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.quad = buffer->nextQuad();

        cerr << "--- FUNC_DEF_API Processing for function: " << $2.name << " ---" << endl; 
        cerr << "Before functionTable.find('" << $2.name << "')" << endl; 
        cerr << "functionTable.size(): " << functionTable.size() << endl; // DEBUG: Table size
        //cerr << "definedFunctions.size(): " << definedFunctions.size() << endl; // DEBUG: Set size

        if ($2.name == "main" && $1.type != void_t) {
            printSemanticError("main function must return void");
        }

        cerr << "Before functionTable.find('" << $2.name << "')" << endl;
        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            cerr << "Function '" << $2.name << "' FOUND in functionTable." << endl; 
            cerr << "existingFunc.startLineImplementation: " << existingFunc.startLineImplementation << endl; 
            cerr << "existingFunc.defined: " << existingFunc.isDefined << endl; // DEBUG: defined flag value
            if (existingFunc.isDefined == true) {
                cerr << "*** Redefinition check triggered! ***" << endl;
                printSemanticError("2redefinition of function '" + $2.name + "'");
            } else {
                cerr << "Function was declared, now defining." << endl;
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            cerr << "Function '" << $2.name << "' NOT found in functionTable. Creating new entry." << endl;
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.startLineImplementation = $$.quad;
            newFunc.isDefined = true; 
            inVariadicFunction = false;
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
            //currentFunctionName = $2.name;
            cerr << "functionTable.size() AFTER insert: " << functionTable.size() << endl; // DEBUG: Table size after insert
            //cerr << "definedFunctions.size() AFTER insert: " << definedFunctions.size() << endl; // DEBUG: Set size after insert

            //buffer->emit("ADD2I I2 I2 4"); // Allocate stack space for variable 'a'
            //buffer->emit("ADD2I I2 I2 4"); // Allocate stack space for variable 'n'

            cerr << "New function '" << $2.name << "' added to functionTable." << endl;
            cerr << "newFunc.startLineImplementation set to: " << newFunc.startLineImplementation << endl;
            cerr << "functionTable['" << $2.name << "'].startLineImplementation: " << functionTable[$2.name].startLineImplementation << endl;
        }
         cerr << "--- FUNC_DEF_API Processing END for function: " << $2.name << " ---" << endl;
    }
    | TYPE ID LPAREN FUNC_ARGLIST RPAREN
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN FUNC_ARGLIST RPAREN" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            if (existingFunc.isDefined == true) {
                printSemanticError("3redefinition of function '" + $2.name + "'");
            } else {
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            Function newFunc;
            newFunc.isDefined = true;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            inVariadicFunction = false;
            newFunc.startLineImplementation = buffer->nextQuad();
            //currentFunctionName = $2.name;
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    | TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
             if (existingFunc.isDefined == true) {
                printSemanticError("4redefinition of function '" + $2.name + "'");
            } else {
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            Function newFunc;
            newFunc.isDefined = true;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            inVariadicFunction = true;
            //currentFunctionName = $2.name;
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    ;

FUNC_ARGLIST:
    FUNC_ARGLIST COMMA DCL
    {
        #if DEBUG_PARSER
        cerr << "FUNC_ARGLIST: FUNC_ARGLIST COMMA DCL" << endl;
        #endif
        #if DEBUG_PARSER
        cerr << "FUNC_ARGLIST: Processed argument list." << endl;
        for (size_t i = 0; i < $$.paramTypes.size(); ++i) {
            cerr << "    Arg " << i << ": " << $$.paramIds[i] << " (type " << $$.paramTypes[i] << ")" << endl;
        }
        #endif
        $$.paramTypes = $1.paramTypes;
        $$.paramTypes.push_back($3.type);
        $$.paramIds = $1.paramIds;
        $$.paramIds.push_back($3.name);
        $$.quad = buffer->nextQuad();
    }
    | DCL
    {
        #if DEBUG_PARSER
        cerr << "FUNC_ARGLIST: DCL" << endl; // Add debug print here
        #endif
        $$.paramTypes.push_back($1.type);
        $$.paramIds.push_back($1.name);
        $$.quad = buffer->nextQuad();
    }
    ;

BLK:
    LBRACE STLIST M RBRACE
    {
        #if DEBUG_PARSER
        cerr << "BLK: LBRACE STLIST M RBRACE" << endl; // Add debug print here
        #endif
        $$.quad = $2.quad;
        $2.name = $$.name; //needed for VA_MATERIALISE
        // Reset scope after block ends
        //currentScopeRegsNum = 3;  // Reset register allocation
        // Don't clear symbol table here - only clear at function level
        //buffer->emit(string("RETRN")); // Moved RETRN emission to the end of BLK rule
    }
    ;

DCL:
    ID COLON TYPE
    {
        #if DEBUG_PARSER
        cerr << "DCL: ID COLON TYPE" << endl;
        #endif
        $$.name = $1.name;
        $$.type = $3.type;
        $$.quad = buffer->nextQuad();
        
        // Check redeclaration
        if (symbolTable.find($1.name) != symbolTable.end() &&
            symbolTable[$1.name].type.find(currentScopeOffset) != symbolTable[$1.name].type.end()) {
            printSemanticError("redefinition of variable '" + $1.name + "'");
        }
        
        // Allocate one register to hold this variable's *base address*
        $$.RegNum = currentScopeRegsNum++;
        
        // Current offset
        int varOffset = currentScopeOffset;
        
        // "I1" = frame pointer. We do: baseReg = I1 + varOffset
        buffer->emit("ADD2I I" + to_string($$.RegNum) + " I1 " + to_string(varOffset));
        
        // Optionally initialize memory to 0 or 0.0
        int initReg = currentScopeRegsNum++;
        if ($3.type == int_) {
            buffer->emit("COPYI I" + to_string(initReg) + " 0");
            buffer->emit("STORI I" + to_string(initReg) + " I" + to_string($$.RegNum) + " 0");
        } else if ($3.type == float_) {
            buffer->emit("COPYF F" + to_string(initReg) + " 0.0");
            buffer->emit("STORF F" + to_string(initReg) + " I" + to_string($$.RegNum) + " 0");
        } 
        // else void_t => error if we allow? Already checked above or in printSemanticError
        
        // Update symbol table
        Symbol newSymbol;
        newSymbol.type[currentScopeOffset] = $3.type;
        newSymbol.offset[currentScopeOffset] = varOffset;
        newSymbol.depth = currentScopeOffset;
        
        
        symbolTable[$1.name] = newSymbol;
        
        currentScopeOffset += 4;
    }
    | ID COMMA DCL
    {
        #if DEBUG_PARSER
        cerr << "ID COMMA DCL" << endl;
        #endif
        $$.name = $1.name;
        $$.type = $3.type; 
        $$.quad = buffer->nextQuad();

        // Check redeclaration
        if (symbolTable.find($1.name) != symbolTable.end() &&
            symbolTable[$1.name].type.find(currentScopeOffset) != symbolTable[$1.name].type.end()) {
            printSemanticError("redefinition of variable '" + $1.name + "'");
        }

        Symbol newSymbol;
        newSymbol.type[currentScopeOffset] = $3.type;
        newSymbol.offset[currentScopeOffset] = currentScopeOffset;
        newSymbol.depth = currentScopeOffset;

        // Allocate register for address calculation (REMOVE baseReg)
        int addrReg = currentScopeRegsNum++;
        buffer->emit("ADD2I I" + to_string(addrReg) + " I1 " + to_string(currentScopeOffset));

        // Initialize variable
        int initReg = currentScopeRegsNum++;
        if ($3.type == float_) {
            buffer->emit("COPYF F" + to_string(initReg) + " 0.0");
            buffer->emit("STORF F" + to_string(initReg) + " I" + to_string(addrReg) + " 0");
        } else {
            buffer->emit("COPYI I" + to_string(initReg) + " 0");
            buffer->emit("STORI I" + to_string(initReg) + " I" + to_string(addrReg) + " 0");
        }

        symbolTable[$1.name] = newSymbol;
        currentScopeOffset += 4;
        $$.RegNum = addrReg; // Use addrReg directly
    }
    ;

TYPE:
    INT
    {
        #if DEBUG_PARSER
        cerr << "TYPE: INT" << endl;
        #endif
        $$.type = int_;
        $$.quad = buffer->nextQuad();
    }
    | FLOAT 
    {
        #if DEBUG_PARSER
        cerr << "TYPE: FLOAT" << endl;
        #endif
        $$.type = float_;
        $$.quad = buffer->nextQuad();
    }
    | VOID
    {
        #if DEBUG_PARSER
        cerr << "TYPE: VOID" << endl;
        #endif
        $$.type = void_t;
        $$.quad = buffer->nextQuad();
    }
    ;

STLIST:
    STLIST STMT
    {
        #if DEBUG_PARSER
        cerr << "STLIST: STLIST STMT" << endl;
        #endif
        $$.quad = $2.quad;  // Pass up the quad of the last statement
        $$.nextList = $2.nextList;  // Pass up any unresolved jumps
        $2.name = $$.name;
    }
    | /* empty */
    {
        #if DEBUG_PARSER
        cerr << "STLIST: empty" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.nextList.clear();  // Initialize empty nextList
    }
    ;

STMT:
    DCL SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "STMT: DCL SEMICOLON" << endl;
        #endif
        $$.quad = $1.quad;
        $$.type = $1.type;
        $$.nextList.clear();
    }
    | ASSN_STMT      
    { 
        #if DEBUG_PARSER
        cerr << "STMT: ASSN_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        $$.type = $1.type;
        $$.nextList = $1.nextList;
    }
    | EXP SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "STMT: EXP SEMICOLON" << endl;
        #endif
        $$.quad = $1.quad;
        $$.type = $1.type;
        $1.name = $$.name; //needed for VA_MATERIALISE
        $$.nextList.clear();
    }
    | CNTRL_STMT     
    {
        #if DEBUG_PARSER
        cerr << "STMT: CNTRL_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        $$.nextList = $1.nextList;
    }
    | READ_STMT
    {
        #if DEBUG_PARSER
        cerr << "STMT: READ_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        $$.nextList.clear(); 
    }
    | WRITE_STMT     
    {
        #if DEBUG_PARSER
        cerr << "STMT: WRITE_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        $$.nextList.clear();
    }
    | RETURN_STMT    
    {
        #if DEBUG_PARSER
        cerr << "STMT: RETURN_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        $$.nextList.clear();
        
        if (!functionTable.empty()) {
            string currentFunc = ""; 
            for (auto& pair : functionTable) {
                if (pair.second.startLineImplementation != -1) {
                    currentFunc = pair.first;
                    break;
                }
            }
            
            if (!currentFunc.empty()) {
                if ($1.type != functionTable[currentFunc].returnType) {
                    printSemanticError("return type mismatch in function '" + currentFunc + "'");
                }
            }
        }
    }
    | BLK            
    {
        #if DEBUG_PARSER
        cerr << "STMT: BLK" << endl;
        #endif
        $$.quad = $1.quad;
        $$.nextList = $1.nextList;
    }
    ;

RETURN_STMT:
    RETURN EXP SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "RETURN_STMT: RETURN EXP SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.type = $2.type;  // Use $$ to set the type
        
        if ($2.type == float_) {
            buffer->emit(string("COPYF F0 F") + to_string($2.RegNum));  // Copy result to F0
        } else {
            buffer->emit(string("COPYI I0 I") + to_string($2.RegNum));  // Copy result to I0
        }
        buffer->emit(string("RETRN"));
    }
    | RETURN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "RETURN_STMT: RETURN SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.type = void_t;      
        buffer->emit(string("RETRN")); 
    }
    ;

WRITE_STMT:
    WRITE LPAREN EXP RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "WRITE_STMT: WRITE LPAREN EXP RPAREN SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        
        if ($3.type == float_) {
            buffer->emit(string("PRNTF F") + to_string($3.RegNum));
        } else if ($3.type == int_) {
            buffer->emit(string("PRNTI I") + to_string($3.RegNum));
        } else {
            printSemanticError("invalid type for write statement");
        }
    }
    | WRITE LPAREN STRING_LITERAL RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "WRITE_STMT: WRITE LPAREN STRING_LITERAL RPAREN SEMICOLON" << endl;
        #endif
        string str = $3.name;
        str = str.substr(1, str.length() - 2); // Remove surrounding quotes
        
        for (size_t i = 0; i < str.length(); i++) {
            if (str[i] == '\\') {
                // Handle escape sequences
                if (i+1 >= str.length()) break;
                i++; // Skip backslash
                
                switch(str[i]) {
                    case 'n':  // Newline
                        buffer->emit("PRNTC 10");
                        break;
                    case '"':  // Handle escaped quotes
                        buffer->emit("PRNTC 34");
                        break;
                    case '\\': // Backslash
                        buffer->emit("PRNTC 92");
                        break;
                    default:   // Unknown escape
                        buffer->emit("PRNTC " + to_string((int)str[i]));
                }
            } else {
                // Regular character
                buffer->emit("PRNTC " + to_string((int)str[i]));
            }
        }
    }
    ;

    READ_STMT:
        READ LPAREN LVAL RPAREN SEMICOLON
        {
            #if DEBUG_PARSER
            cerr << "READ_STMT: READ LPAREN LVAL RPAREN SEMICOLON" << endl;
            #endif
            Symbol& sym = symbolTable[$3.name];
            int offset = sym.offset[sym.depth];
            int addrReg = currentScopeRegsNum++;
            buffer->emit("ADD2I I" + to_string(addrReg) + " I1 " + to_string(offset));
            
            // Use sym.type instead of varType
            if (sym.type[sym.depth] == float_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit("READF F" + to_string(tempReg));
                buffer->emit("STORF F" + to_string(tempReg) + " I" + to_string(addrReg) + " 0");
            } else {
                int tempReg = currentScopeRegsNum++;
                buffer->emit("READI I" + to_string(tempReg));
                buffer->emit("STORI I" + to_string(tempReg) + " I" + to_string(addrReg) + " 0");
            }
        }
    ;

ASSN_STMT:
    LVAL ASSIGN EXP SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "ASSN_STMT: LVAL ASSIGN EXP SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();

        Symbol& sym = symbolTable[$1.name];
        Type lvalType = sym.type[sym.depth];
        Type expType = $3.type;

        if (lvalType == void_t || expType == void_t) {
            printSemanticError("void type in assignment");
        }

        // $$: 'LVAL' has a register pointing to that var's memory
        int destBase = $1.RegNum;
        int valReg   = $3.RegNum;

        // If float-lval
        if (lvalType == float_) {
            if (expType == float_) {
                buffer->emit("STORF F" + to_string(valReg) + " I" + to_string(destBase) + " 0");
            } else { // int->float
                int newReg = currentScopeRegsNum++;
                buffer->emit("CFTOI I" + to_string(newReg) + " F" + to_string(valReg));
                buffer->emit("STORI I" + to_string(newReg) + " I" + to_string(destBase) + " 0");
            }
        } 
        // else int-lval
        else {
            if (expType == int_) {
                buffer->emit("STORI I" + to_string(valReg) + " I" + to_string(destBase) + " 0");
            } else { // float->int
                int newReg = currentScopeRegsNum++;
                buffer->emit("CITOF F" + to_string(newReg) + " I" + to_string(valReg));
                buffer->emit("STORF F" + to_string(newReg) + " I" + to_string(destBase) + " 0");
            }
        }

        $$.type = lvalType;
        $$.RegNum = destBase;
    }
    ;

LVAL:
    ID
    {
        #if DEBUG_PARSER
        cerr << "LVAL: ID" << endl;
        #endif
        $$.name = $1.name;
        $$.quad = buffer->nextQuad();
        
        if (symbolTable.find($1.name) == symbolTable.end()) {
            printSemanticError("undefined variable '" + $1.name + "'");
        } else {
            Symbol& sym = symbolTable[$1.name];
            if (sym.type.find(sym.depth) == sym.type.end()) {
                printSemanticError("undefined variable '" + $1.name + "' at current scope");
            }
            $$.type = sym.type[sym.depth];
            $$.RegNum = currentScopeRegsNum++;
            buffer->emit("ADD2I I" + to_string($$.RegNum) + " I1 " + 
                        to_string(sym.offset[sym.depth]));
        }
    }
    ;

CNTRL_STMT:
    IF BEXP THEN M STMT ELSE N M STMT
    {
        #if DEBUG_PARSER
        cerr << "CNTRL_STMT:  IF BEXP THEN M STMT ELSE N M STMT" << endl;
        #endif

		buffer->backpatch($2.trueList, $4.quad);
		buffer->backpatch($2.falseList, $8.quad);
		$$.nextList = merge($5.nextList, $7.nextList);
		$$.nextList = merge($$.nextList, $9.nextList);
		$5.nextList.clear();
		$9.nextList.clear();
		$7.nextList.clear();
    }
    | IF BEXP THEN M STMT
    {
        #if DEBUG_PARSER
        cerr << "CNTRL_STMT:  IF BEXP THEN M STMT" << endl;
        #endif
		buffer->backpatch($2.trueList, $4.quad);
		$$.nextList = merge($2.falseList, $5.nextList);
		$2.falseList.clear();
		$5.nextList.clear();
    }
    WHILE M BEXP DO M STMT
    {
        #if DEBUG_PARSER
        cerr << "CNTRL_STMT:  WHILE M BEXP DO M STMT" << endl;
        #endif
		buffer->backpatch($3.trueList, $5.quad);
		buffer->backpatch($6.nextList, $2.quad);
		$$.nextList = $3.falseList;
		// Emit to buffer UJUMP command. After backpatch the addressed would be filled
		buffer->emit("UJUMP " + intToString($2.quad));
    }
    ;

BEXP:
    BEXP OR M BEXP
    {
        #if DEBUG_PARSER
        cerr << "BEXP: BEXP OR BEXP" << endl;
        #endif
		buffer->backpatch($1.falseList, $3.quad);
		$$.falseList = $4.falseList;
		$$.trueList = merge($1.trueList, $4.trueList);
		$1.trueList.clear();
		$4.trueList.clear();
    }
    | BEXP AND M BEXP
    {
        #if DEBUG_PARSER
        cerr << "BEXP: BEXP AND BEXP" << endl;
        #endif
		buffer->backpatch($1.trueList, $3.quad);
		$$.trueList = $4.trueList;
		$$.falseList = merge<int>($1.falseList, $4.falseList);
		$1.falseList.clear();
		$4.falseList.clear();
    }
    | NOT BEXP
    {
        #if DEBUG_PARSER
        cerr << "BEXP: NOT BEXP" << endl;
        #endif
        //$$.quad = buffer->nextQuad();    
        $$.trueList = $2.falseList;
        $$.falseList = $2.trueList;
    }
    | EXP RELOP EXP
    {
        #if DEBUG_PARSER
        cerr << "BEXP: EXP RELOP EXP" << endl;
        #endif
        //$$.quad = buffer->nextQuad();
        if ($1.type != $3.type) {
            printSemanticError("type mismatch in relational expression");
            return 1;
        } else if ($1.type == void_t) {
			printSemanticError("can't perform this operation on 'void' type arguments");
		}

        $$.trueList.push_back(buffer->nextQuad() + 2); 
        $$.falseList.push_back(buffer->nextQuad() + 1);

        $$.RegNum = currentScopeRegsNum++;
        string regType = ($1.type == float_) ? "F" : "I";
        string opName;

        if ($2.name == "==")       opName = "SEQU"; 
        else if ($2.name == "<>")  opName = "SNEQ"; 
        else if ($2.name == "<=" || $2.name == ">")  opName = "SGRT"; 
        else if ($2.name == ">=" || $2.name == "<")  opName = "SLET"; 

        buffer->emit(opName + regType + " " + regType + to_string($$.RegNum) +
                    " " + regType + to_string($1.RegNum) +
                    " " + regType + to_string($3.RegNum));

        if ($2.name == "==" || $2.name == "<>" || $2.name == "<" || $2.name == ">")
        {
            buffer->emit("BREQZ " + regType + to_string($$.RegNum) + " ");
        } else {
            // For >= and <=, we test the opposite condition, so branching when not equal
            buffer->emit("BNEQZ " + regType + to_string($$.RegNum) + " "); 
        }
        buffer->emit("UJUMP ");
    }
    | LPAREN BEXP RPAREN
    {
        #if DEBUG_PARSER
        cerr << "BEXP: LPAREN BEXP RPAREN" << endl;
        #endif
        //$$.quad = $2.quad;
        $$.trueList = $2.trueList;
        $$.falseList = $2.falseList;
    }
    ;

EXP:
    EXP ADDOP EXP
    {
        #if DEBUG_PARSER
        cerr << "EXP: EXP ADDOP EXP" << endl;
        #endif
        //$$.quad = buffer->nextQuad();
        if ($1.type == void_t || $3.type == void_t) {
            printSemanticError("void type in arithmetic expression");
            //return 1;
        }

        string regType = ($$.type == float_) ? "F" : "I"; 
        string opName = ($2.name == "+") ? "ADD2" : "SUBT"; 
        $$.type = ($1.type == float_ || $3.type == float_) ? float_ : int_;
        $$.RegNum = currentScopeRegsNum++;

        // Handle type conversions
        int reg1 = $1.RegNum;
        int reg2 = $3.RegNum;
        
        if ($$.type == float_) {           
            if ($1.type == int_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit(string("CITOF F") + to_string(tempReg) + string(" I") + to_string($1.RegNum));
                reg1 = tempReg;
            }
            if ($3.type == int_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit(string("CITOF F") + to_string(tempReg) + string(" I") + to_string($3.RegNum));
                reg2 = tempReg;
            }
        }

        buffer->emit(opName + regType + " " + regType + to_string($$.RegNum) +  
            " " + regType + to_string(reg1) +                           
            " " + regType + to_string(reg2));
    }
    | EXP MULOP EXP
    {
        #if DEBUG_PARSER
        cerr << "EXP: EXP MULOP EXP" << endl;
        #endif
        //$$.quad = buffer->nextQuad();
        if ($1.type == void_t || $3.type == void_t) {
            printSemanticError("void type in arithmetic expression");
            //return 1;
        }

        string regType = ($$.type == float_) ? "F" : "I";
        string opName = ($2.name == "*") ? "MULT" : "DIVD";
        $$.type = ($1.type == float_ || $3.type == float_) ? float_ : int_;
        $$.RegNum = currentScopeRegsNum++;

        // Handle type conversions
        int reg1 = $1.RegNum;
        int reg2 = $3.RegNum;

        if ($$.type == float_) {
            // Convert left operand to float if needed
            if ($1.type == int_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit("CITOF F" + to_string(tempReg) + " I" + to_string(reg1));
                reg1 = tempReg;
            }
            // Convert right operand to float if needed
            if ($3.type == int_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit("CITOF F" + to_string(tempReg) + " I" + to_string(reg2));
                reg2 = tempReg;
            }
        }

        buffer->emit(opName + regType + " " + regType + to_string($$.RegNum) +
            " " + regType + to_string(reg1) +
            " " + regType + to_string(reg2));
    }
    | LPAREN EXP RPAREN
    {
        #if DEBUG_PARSER
        cerr << "EXP: LPAREN EXP RPAREN" << endl;
        #endif
        $$ = $2;  // Pass through all attributes
    }
    | LPAREN TYPE RPAREN EXP
    {
        #if DEBUG_PARSER
        cerr << "EXP: LPAREN TYPE RPAREN EXP" << endl;
        #endif
        if ($2.type == void_t && $4.type != void_t) {  
            printSemanticError("can't cast a non-void expression to void");
        } else if ($2.type != void_t && $4.type == void_t) {
            printSemanticError("can't perform this operation on 'void' type argument");
        }
        $$.type = $2.type;

        if ($2.type == $4.type) {
            $$.RegNum = $4.RegNum;
        } else if ($2.type == float_ && $4.type == int_) {
            $$.RegNum = currentScopeRegsNum++;
            $$.type = float_; 
            buffer->emit("CITOF F" + to_string($$.RegNum) + " I" + to_string($4.RegNum)); 
        } else if ($2.type == int_ && $4.type == float_) {
            $$.RegNum = currentScopeRegsNum++;
            $$.type = int_;
            buffer->emit("CFTOI I" + to_string($$.RegNum) + " F" + to_string($4.RegNum)); 
        } 
    }
    | ID
    {
        #if DEBUG_PARSER
        cerr << "EXP: ID" << endl;
        #endif
        //$$.quad = buffer->nextQuad();
        
        if (symbolTable.find($1.name) == symbolTable.end()) {
            printSemanticError("unDefined variable '" + $1.name + "'");
            //return 1;
        }
        
        Symbol& sym = symbolTable[$1.name];
        if (sym.type.find(sym.depth) == sym.type.end()) {
            printSemanticError("unDefined variable '" + $1.name + "' at current scope");
            return 1;
        }
        
        $$.type = sym.type[sym.depth];
        $$.RegNum = currentScopeRegsNum++;
        $$.name = $1.name;

        if ($$.type == float_) {
            buffer->emit(string("LOADF F") + 
                         to_string($$.RegNum) + string(" F") +
                         to_string(sym.offset[sym.depth]));
        } else {
            buffer->emit(string("LOADI I") + 
                         to_string($$.RegNum) + string(" I") +
                         to_string(sym.offset[sym.depth]));
        }
    }       
    | NUM
    {
        #if DEBUG_PARSER
        cerr << "EXP: NUM" << endl;
        #endif
        $$.type = ($1.type == int_) ? int_ : float_; 
        $$.RegNum = currentScopeRegsNum++; 
        $$.name = $1.name; 

        if ($$.type == float_) {
            buffer->emit("COPYF F" + to_string($$.RegNum) + " " + $1.name);
        } else { // int_
            buffer->emit("COPYI I" + to_string($$.RegNum) + " " + $1.name); 
        }
    }
    | CALL
    {
        #if DEBUG_PARSER
        cerr << "EXP: CALL" << endl;
        #endif
		$$.RegNum = $1.RegNum;
		$$.type = $1.type;
    }
    | VA_MATERIALISE
    {
        #if DEBUG_PARSER
        cerr << "EXP: VA_MATERIALISE" << endl;
        #endif
        $$ = $1;
        $1.name = $$.name; //needed?
    }
    ;

NUM:
    INTEGERNUM  
    {
        #if DEBUG_PARSER
        cerr << "NUM: INTEGERNUM" << endl;
        #endif
        $$.type = int_;
        $$.RegNum = currentScopeRegsNum++;
        buffer->emit(string("COPYI I") + to_string($$.RegNum) + " " + $1.name); 
        //$$.quad = buffer->nextQuad();
    }
    | REALNUM       
    {
        #if DEBUG_PARSER
        cerr << "NUM: REALNUM" << endl;
        #endif
        $$.type = float_;
        $$.RegNum = currentScopeRegsNum++;
        buffer->emit(string("COPYF F") + to_string($$.RegNum) + " " + $1.name);
        //$$.quad = buffer->nextQuad();
    }
    ;

CALL:
    ID LPAREN CALL_ARGS RPAREN
    {
        #if DEBUG_PARSER
        cerr << "CALL: ID LPAREN CALL_ARGS RPAREN" << endl;
        #endif
        //$$.quad = buffer->nextQuad();
        
        // Check if function name was declared
        if (functionTable.find($1.name) == functionTable.end()) {
            printSemanticError("unDefined function '" + $1.name + "'");
            return 1;
        }
        
        Function& func = functionTable[$1.name];
		// Check if number of arguments is correct
		if (func.paramTypes.size() != $3.paramTypes.size()) {
			printSemanticError("incorrect number of arguments of function '" +
                                $1.name + "'");
		}

		//check arguments type compatibility
		for (int i = 0; i < (int)func.paramTypes.size(); i++) {
			if (func.paramTypes[i] != $3.paramTypes[i]) {
                printSemanticError("incompatible type of argument " +
                                    to_string(i + 1) + " to function '" + $1.name + "'");	            
    		}
		}
        
        // Stack Alignment
        int alignmentOffset = 0;
        if (currentScopeOffset % 4 != 0) {
            alignmentOffset = 4 - (currentScopeOffset % 4);
            currentScopeOffset += alignmentOffset;
            buffer->emit("ADD2I I2 I2 " + to_string(alignmentOffset));
        }

        // Variadic Argument Count ('n') Handling
        int n = 0;
        int offsetForN = currentScopeOffset;
        if (func.startIndexVAParams != -1) {  // If it's a variadic function
            n = $3.paramTypes.size() - func.startIndexVAParams;
            buffer->emit("COPYI I10 " + to_string(n));
            buffer->emit("STORI I10 I2 " + to_string(offsetForN));
            currentScopeOffset += 4; 
        }

        // Save Registers - Start after 'n' (if present)
        int savedRegsOffset = currentScopeOffset; 
        
        for (int i = 0; i < currentScopeRegsNum; ++i) {
                buffer->emit("STORI I" + to_string(i) + " I2 " +
                             to_string(savedRegsOffset));
                savedRegsOffset += 4;
        }
        currentScopeOffset = savedRegsOffset; 

        // Add space for return value
        int returnValueOffset = currentScopeOffset; 
        if (func.returnType != void_t) {
            buffer->emit("ADD2I I2 I2 4");
            currentScopeOffset += 4;   
            returnValueOffset += 4;          
        }

        // Parameter Passing (with casting as before)
        int paramsOffset = -4; 
        for (size_t i = 0; i < $3.paramRegs.size(); i++) {
            paramsOffset -= 4; // Decrement by 4 for each parameter

            // Cast parameters to the correct types if needed.
            string paramTypeStr = ($3.paramTypes[i] == float_) ? "F" : "I";
            int reg = $3.paramRegs[i];

            // Check for casting
            if (func.paramTypes[i] != $3.paramTypes[i]) {
            int tempReg = currentScopeRegsNum++;
            string funcTypeStr = (func.paramTypes[i] == float_) ? "F" : "I";
            if ($3.paramTypes[i] == int_) { // Casting int to float
                buffer->emit(string("CITOF F") + to_string(tempReg) + 
                                string(" I") + to_string($3.paramRegs[i]));
            } else { // Casting float to int
                buffer->emit(string("CFTOI I") + to_string(tempReg) +
                                string(" F") + to_string($3.paramRegs[i]));
            }
            reg = tempReg;
            paramTypeStr = funcTypeStr;
            }

            buffer->emit("STOR" + paramTypeStr + " " + paramTypeStr + 
                         to_string(reg) + " I2 " + to_string(paramsOffset));
        }

        // Adjust Stack Pointer (for parameters, 'n', and return value)
        buffer->emit("ADD2I I2 I2 " + to_string(currentScopeOffset + (-paramsOffset - 4)));
        buffer->emit("COPYI I1 I2"); // Set frame pointer

		// Add the current line number to the calling lines list of the current function
        functionTable[$1.name].callingLines.push_back(buffer->nextQuad());
        buffer->emit("JLINK ");
		
        // Back from function, set the stack frame I2 = I1
		buffer->emit("COPYI I2 I1");

        // Return Value Handling
        $$.type = func.returnType;
        if ($$.type != void_t) {
            $$.RegNum = currentScopeRegsNum++;
            string retTypeStr = ($$.type == float_) ? "F" : "I";
            buffer->emit("LOAD" + retTypeStr + " " + retTypeStr +
                         to_string($$.RegNum) + " I1 "+ to_string(returnValueOffset));
        }

        // Restore Registers 
        savedRegsOffset = 0;
        for (int i = 0; i < currentScopeRegsNum; i++) { 
            if(i == $$.RegNum)
            {
                savedRegsOffset+=4; // Skip the register if its the return value register
                continue;
            }
            buffer->emit("LOADI I" + to_string(i) + " I1 " + to_string(savedRegsOffset));
            savedRegsOffset += 4;
        }
        
        //Deallocate everything that was allocated in this scope
        buffer->emit("SUBTI I2 I2 " + to_string(-paramsOffset - 4));
        currentScopeOffset = 0;

        // Only increment if return type is not void 
        if ($$.type != void_t) {
            $$.RegNum = currentScopeRegsNum++;
        }
    }
    ;

VA_MATERIALISE:
    VA_ARG LPAREN TYPE COMMA EXP RPAREN
    {
        #if DEBUG_PARSER
        cerr << "VA_MATERIALISE: VA_ARG LPAREN TYPE COMMA EXP RPAREN" << endl;
        #endif

        // Mark basic parser fields
        $$.quad  = buffer->nextQuad();
        $$.type  = $3.type;  
        $$.RegNum = currentScopeRegsNum++;
        string currentFunctionName = $$.name;
        Function& func = functionTable[currentFunctionName];

        //need to set in DEC\DEF: startIndexVAParams = -1 if not variadac

        // Ensure we are indeed inside a variadic function
        if (func.startIndexVAParams == -1) {
            printSemanticError("va_arg used outside of a variadic function");
        }

        // Find the name of the n param (count) in the current function
        string countParamName = func.paramIds.back();
        
        // Lookup that param in the symbol table to get offset
        if (symbolTable.find(countParamName) == symbolTable.end()) {
            printSemanticError("count param '" + countParamName + "' not found in symbol table");
        }
        Symbol& symN = symbolTable[countParamName];
        int offsetOfN = symN.offset[symN.depth];

        // Load n (the number of variadic arguments)
        int nReg = currentScopeRegsNum++;
        buffer->emit("LOADI I" + to_string(nReg) + " I1 " + to_string(offsetOfN));

        // Check index >= 0
        int indexReg = $5.RegNum;
        int tempReg1 = currentScopeRegsNum++;
        buffer->emit("SLETI I" + to_string(tempReg1) + " I" + to_string(indexReg) + " 0");
        int errorBranch1 = buffer->nextQuad();
        // backpatch target => runtime error 
        buffer->emit("BREQZ I" + to_string(tempReg1) + " "); 

        // Check index < n
        int tempReg2 = currentScopeRegsNum++;
        // set if (index >= n) => error
        buffer->emit("SGRTI I" + to_string(tempReg2) + " I" + to_string(indexReg)
                     + " I" + to_string(nReg));
        int errorBranch2 = buffer->nextQuad();
        // => runtime error if index >= n
        buffer->emit("BNEQZ I" + to_string(tempReg2) + " "); 

        // Compute address of argument: "base = (I1 + offsetOfN) + 4" + index * 4
        int baseReg   = currentScopeRegsNum++;  // Store the start of optional params
        int finalAddr = currentScopeRegsNum++;  // The final address

        // base = I1 + offsetOfN
        buffer->emit("ADD2I I" + to_string(baseReg) 
                     + " I1 " + to_string(offsetOfN));

        // base = base + 4  (skip the count param itself)
        buffer->emit("ADD2I I" + to_string(baseReg) 
                     + " I" + to_string(baseReg) + " 4");

        // multiply index * 4
        int indexOffsetReg = currentScopeRegsNum++;
        buffer->emit("MULTI I" + to_string(indexOffsetReg)
                     + " I" + to_string(indexReg) + " 4");

        // finalAddr = base + indexOffset
        buffer->emit("ADD2I I" + to_string(finalAddr)
                     + " I" + to_string(baseReg)
                     + " I" + to_string(indexOffsetReg));

        // 7) Load the argument (int or float)
        string loadType = ($3.type == float_) ? "F" : "I";
        buffer->emit("LOAD" + loadType + " " + loadType + to_string($$ .RegNum)
                     + " I" + to_string(finalAddr) + " 0");

        // Set up a short runtime-error - print "Runtime error!\n" and HALT.
        int runtimeErrorLine = buffer->nextQuad();
        buffer->emit("PRNTC 82");  // 'R'
        buffer->emit("PRNTC 117"); // 'u'
        buffer->emit("PRNTC 110"); // 'n'
        buffer->emit("PRNTC 116"); // 't'
        buffer->emit("PRNTC 105"); // 'i'
        buffer->emit("PRNTC 109"); // 'm'
        buffer->emit("PRNTC 101"); // 'e'
        buffer->emit("PRNTC 32");  // ' '
        buffer->emit("PRNTC 101"); // 'e'
        buffer->emit("PRNTC 114"); // 'r'
        buffer->emit("PRNTC 114"); // 'r'
        buffer->emit("PRNTC 111"); // 'o'
        buffer->emit("PRNTC 114"); // 'r'
        buffer->emit("PRNTC 33");  // '!'
        buffer->emit("PRNTC 10");  // newline
        buffer->emit("HALT");

        // Backpatch those two error branches to jump to runtimeErrorLine
        vector<int> errorBranches;
        errorBranches.push_back(errorBranch1);
        errorBranches.push_back(errorBranch2);
        buffer->backpatch(errorBranches, runtimeErrorLine);
    }
    ;

CALL_ARGS:
    CALL_ARGLIST
    {
        #if DEBUG_PARSER
        cerr << "CALL_ARGS: CALL_ARGLIST" << endl;
        #endif
		$$.paramTypes = $1.paramTypes;	
		$$.paramRegs = $1.paramRegs;
		$1.paramTypes.clear();
		$1.paramRegs.clear();      
    }
    | /* empty */
    {
        #if DEBUG_PARSER
        cerr << "CALL_ARGS: empty" << endl;
        #endif
    }
    ;

CALL_ARGLIST:
    CALL_ARGLIST COMMA EXP
    {
        #if DEBUG_PARSER
        cerr << "CALL_ARGS: CALL_ARGLIST COMMA EXP" << endl;
        #endif
        //$$.quad = buffer->nextQuad();
        $$.paramTypes = $1.paramTypes;
        $$.paramRegs = $1.paramRegs;
        $$.paramTypes.push_back($3.type);
        $$.paramRegs.push_back($3.RegNum);
        $1.paramTypes.clear();
		$1.paramRegs.clear();
    }
    | EXP
    {
        #if DEBUG_PARSER
        cerr << "CALL_ARGS: EXP" << endl;
        #endif
        //$$.quad = buffer->nextQuad();
        $$.paramTypes.push_back($1.type);
        $$.paramRegs.push_back($1.RegNum);
    }
    ;

	M : /* EPSILON */ {
		$$.quad = buffer->nextQuad();
	}
	;
 

	N : /* EPSILON */ {
		$$.nextList.push_back(buffer->nextQuad());
		buffer->emit("UJUMP ");
	}
	;
%%

int main(int argc, char* argv[]) {
    // Check number of arguments
    if (argc != 2) {
        cerr << "Operational error: invalid number of arguments" << endl;
        exit(OPERATIONAL_ERROR);
    }

    string inputFileName = argv[1];
    
    // Check file extension
    size_t lastindex = inputFileName.find_last_of(".");
    if (lastindex == string::npos || inputFileName.substr(lastindex) != ".cmm") {
        cerr << "Operational error: invalid file type. expecting '.cmm' extension" << endl;
        exit(OPERATIONAL_ERROR);
    }

    // Open input file
    extern FILE* yyin;
    yyin = fopen(argv[1], "r");
    if (yyin == NULL) {
        cerr << "Operational error: cannot open input file" << endl;
        exit(OPERATIONAL_ERROR);
    }

    // Initialize buffer
    buffer = new Buffer();

    // Parse input
    if (yyparse() != 0) {
        // Error handling is done in yyerror
        fclose(yyin);
        yylex_destroy();  
        delete buffer;
        return 1;
    }

    // Generate header
    string header = "<header>\n";
    
    // Generate unimplemented functions list
    string uimp = "<unimplemented>";
    for (const auto& func : functionTable) {
        if (func.second.startLineImplementation == -1) {
            uimp += " " + func.first;
            for (int line : func.second.callingLines) {
                uimp += "," + to_string(line);
            }
        }
    }
    header += uimp + "\n";

    // Generate implemented functions list
    string imp = "<implemented>";
    for (const auto& func : functionTable) {
        if (func.second.startLineImplementation != -1) {
            imp += " " + func.first + "," + to_string(func.second.startLineImplementation);
        }
    }
    header += imp + "\n";
    header += "</header>\n";

    // Add header to beginning of buffer
    buffer->frontEmit(header);

    // Generate output file name
    string outputFileName = inputFileName.substr(0, lastindex) + ".rsk";
    size_t found = outputFileName.find_last_of("/\\");
    if (found != string::npos) {
        outputFileName = outputFileName.substr(found + 1);
    }

    // Write to output file
    ofstream rskFile(outputFileName);
    if (!rskFile.is_open()) {
        cerr << "Operational error: cannot create output file" << endl;
        fclose(yyin);
        yylex_destroy();  
        delete buffer;
        exit(OPERATIONAL_ERROR);
    }

    rskFile << buffer->printBuffer();
    rskFile.close();
    fclose(yyin);
    yylex_destroy();

    delete buffer;
    return 0;
}

void yyerror(const char *s) {
    cerr << "Syntax error: '" << yytext << "' in line number " << yylineno << endl;
    exit(SYNTAX_ERROR);
}

int printOperationalError (string err) {
	cerr << "Operational error: " << err << endl;
	exit(OPERATIONAL_ERROR);
}

int printSemanticError (string err) {
	cerr << "Semantic error: " << err << " in line number " << yylineno << endl;
	exit(SEMANTIC_ERROR);
}