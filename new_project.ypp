%{

#include <iostream>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <vector>
#include <string>
#include <map>
#include "part3_helpers.hpp"

#define DEBUG_PARSER 1

#ifdef __cplusplus
extern "C" {
#endif

#if defined(FLEX_SCANNER) || defined(FLEXPP_SCANNER)
extern int yylex_destroy(void);
#else
#define yylex_destroy() (0)
#endif

#ifdef __cplusplus
}
#endif

int printOperationalError (string err);
int printSemanticError(string err);

typedef yystype YYSTYPE;
extern int yylineno;
extern char* yytext;
int yylex(void);
void yyerror(const char *s);

// Global variables
extern Buffer* buffer;
extern map<string, Symbol> symbolTable;
extern map<string, Function> functionTable;
int currentScopeRegsNum = 3;
int currentScopeOffset = 0;
Type currentReturnType;
bool inVariadicFunction = false;

int current_variable_offset = 0;
int current_param_offset = -8;
vector<string> current_symbols;

%}

/*%union {
    yystype yystype;  // Use the struct isDefined in part3_helpers.hpp
}*/

/* Keywords and operators */
%token  INT FLOAT VOID
%token  RETURN WRITE READ
%token  WHILE IF THEN ELSE DO
%token  ASSIGN VA_ARG ELLIPSIS
%token  OR AND NOT
%token  ID INTEGERNUM REALNUM STRING_LITERAL RELOP ADDOP MULOP
%token  COMMA SEMICOLON LPAREN RPAREN LBRACE RBRACE COLON

/* Operator precedence and associativity */
%right ASSIGN
%right IF THEN ELSE
%left OR
%left AND
%left RELOP
%left ADDOP
%left MULOP
%right NOT
%left LPAREN
%left RPAREN
%left LBRACE
%left RBRACE
%left COLON
%left SEMICOLON

/* Non-terminal types
%type  PROGRAM FDEFS FUNC_DEC_API FUNC_DEF_API FUNC_ARGLIST
%type  DCL STLIST STMT ASSN_STMT LVAL CNTRL_STMT
%type  BEXP EXP CALL CALL_ARGS CALL_ARGLIST
%type  NUM VA_MATERIALISE BLK RETURN_STMT WRITE_STMT READ_STMT TYPE
%type  M N
%start PROGRAM*/

%%

PROGRAM:
    FDEFS
    {
        #if DEBUG_PARSER
        cerr << "PROGRAM: Finished parsing FDEFS." << endl;
        #endif
        // Backpatch function calls
        for(auto& func : functionTable) {
            buffer->backpatch(func.second.callingLines, func.second.startLineImplementation);
        }

        /*// Add HALT AFTER all functions
        buffer->emit("HALT");*/
    }
;

FDEFS:
    FDEFS FUNC_DEF_API BLK
    {
        #if DEBUG_PARSER
        cerr << "FDEFS: FDEFS FUNC_DEF_API BLK" << endl;
        #endif
        // Backpatch function calls
        for(auto& func : functionTable) {
            buffer->backpatch(func.second.callingLines, func.second.startLineImplementation);
        }

        buffer->backpatch($3.nextList, buffer->nextQuad());
        // Emit RETRN at the end of the function
        buffer->emit("RETRN");

        // Initialize the relevant globals
        currentScopeRegsNum = 3;
        currentScopeOffset = 0;
        current_variable_offset = 0;
        current_param_offset = -8;
        symbolTable.clear();
        $2.paramTypes.clear();
    }
    | FDEFS FUNC_DEC_API
    {
        #if DEBUG_PARSER
        cerr << "FDEFS: FDEFS FUNC_DEC_API" << endl;
        #endif
        /*if (functionTable[$2.name].startLineImplementation != -1) {
            printSemanticError("function '" + $2.name + "' already isDefined");
        }
        functionTable[$2.name].startLineImplementation = -1;
        functionTable[$2.name].callingLines.clear();
        symbolTable.clear();*/
    }
    | /* empty */ { }
;

FUNC_DEC_API:
    TYPE ID LPAREN RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN RPAREN SEMICOLON" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.quad = buffer->nextQuad(); // TODO: Is this correct?

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" + $2.name + "'");
            }
            if (!existingFunc.paramTypes.empty()) {
                printSemanticError("conflicting parameter types for function declaration '" + $2.name + "'");
            }
        } else {
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.startLineImplementation = -1;
            newFunc.isDefined = false; // Mark as NOT isDefined for declaration
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    | TYPE ID LPAREN FUNC_ARGLIST RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN M FUNC_ARGLIST RPAREN SEMICOLON" << endl;
        for (size_t i = 0; i < $4.paramTypes.size(); ++i) {
            cerr << "    Arg " << i << ": " << $4.paramIds[i] << " (type " << $4.paramTypes[i] << ")" << endl;
        }
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" + $2.name + "'");
            }
            if (existingFunc.paramTypes != $4.paramTypes) {
                printSemanticError("conflicting parameter types for function declaration '" + $2.name + "'");
            }
        } else {
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.startLineImplementation = -1;
            newFunc.isDefined = false; // Mark as NOT isDefined for declaration
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    | TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN SEMICOLON" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad(); // TODO: Is this correct?

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for variadic function declaration '" + $2.name + "'");
            }
            if (existingFunc.paramTypes != $4.paramTypes) {
                printSemanticError("conflicting parameter types for variadic function declaration '" + $2.name + "'");
            }
        } else {
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.startLineImplementation = -1;
            newFunc.isDefined = false; // Mark as NOT isDefined for declaration
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
;

FUNC_DEF_API:
    TYPE ID LPAREN RPAREN
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN RPAREN" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.quad = buffer->nextQuad();
        /*
        cerr << "--- FUNC_DEF_API Processing for function: " << $2.name << " ---" << endl;
        cerr << "Before functionTable.find('" << $2.name << "')" << endl;
        cerr << "functionTable.size(): " << functionTable.size() << endl; // DEBUG: Table size
        //cerr << "definedFunctions.size(): " << definedFunctions.size() << endl; // DEBUG: Set size
        */
        if ($2.name == "main" && $1.type != void_t) {
            printSemanticError("main function must return void");
        }

        //cerr << "Before functionTable.find('" << $2.name << "')" << endl;
        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            #if DEBUG_PARSER
            cerr << "Function '" << $2.name << "' FOUND in functionTable." << endl;
            cerr << "existingFunc.startLineImplementation: " << existingFunc.startLineImplementation << endl;
            cerr << "existingFunc.defined: " << existingFunc.isDefined << endl; // DEBUG: defined flag value
            #endif

            if (existingFunc.isDefined == true) {
                #if DEBUG_PARSER
                cerr << "*** Redefinition check triggered! ***" << endl;
                #endif
                printSemanticError("2 redefinition of function '" + $2.name + "'");
            } else {
                #if DEBUG_PARSER
                cerr << "Function was declared, now defining." << endl;
                #endif
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            #if DEBUG_PARSER
            cerr << "Function '" << $2.name << "' NOT found in functionTable. Creating new entry." << endl;
            #endif
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.startLineImplementation = $$.quad;
            newFunc.isDefined = true; // Mark as isDefined when first isDefined!
            newFunc.indexNumVAParams = -1;
            newFunc.startIndexVAParams = -1;
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
            #if DEBUG_PARSER
            cerr << "functionTable.size() AFTER insert: " << functionTable.size() << endl; // DEBUG: Table size after insert
            //cerr << "definedFunctions.size() AFTER insert: " << definedFunctions.size() << endl; // DEBUG: Set size after insert

            cerr << "New function '" << $2.name << "' added to functionTable." << endl;
            cerr << "newFunc.startLineImplementation set to: " << newFunc.startLineImplementation << endl;
            cerr << "functionTable['" << $2.name << "'].startLineImplementation: " << functionTable[$2.name].startLineImplementation << endl;
            #endif
        }
        #if DEBUG_PARSER
        cerr << "--- FUNC_DEF_API Processing END for function: " << $2.name << " ---" << endl;
        #endif
    }
    | TYPE ID LPAREN FUNC_ARGLIST RPAREN
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN FUNC_ARGLIST RPAREN" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            if (existingFunc.isDefined == true) {
                printSemanticError("3 redefinition of function '" + $2.name + "'");
            } else {
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            Function newFunc;
            newFunc.isDefined = true;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.indexNumVAParams = -1;
            newFunc.startIndexVAParams = -1;
            newFunc.startLineImplementation = buffer->nextQuad();
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    | TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN
    {
        #if DEBUG_PARSER
        cerr << "FUNC_DEF_API: TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN" << endl;
        #endif
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
             if (existingFunc.isDefined) {
                printSemanticError("4 redefinition of function '" + $2.name + "'");
            } else {
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            Function newFunc;
            newFunc.isDefined = true;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.indexNumVAParams = $4.paramTypes.size();
            newFunc.startIndexVAParams = newFunc.indexNumVAParams + 1;
            newFunc.startLineImplementation = buffer->nextQuad();
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }

        int num_va_params_index = $4.paramTypes.size();
        int num_va_params_reg = currentScopeRegsNum;
        ++currentScopeRegsNum;
        if (3 != num_va_params_reg)
        {
            printOperationalError("Something went wrong. VA num reg should be 3.");
        }
        buffer->emit("COPYI I" + to_string(num_va_params_reg) + " " + to_string(num_va_params_index));
    }
;

FUNC_ARGLIST:
    FUNC_ARGLIST COMMA DCL
    {
        #if DEBUG_PARSER
        cerr << "FUNC_ARGLIST: FUNC_ARGLIST COMMA DCL" << endl;
        #endif
        #if DEBUG_PARSER
        cerr << "FUNC_ARGLIST: Processed argument list." << endl;
        for (size_t i = 0; i < $$.paramTypes.size(); ++i) {
            cerr << "    Arg " << i << ": " << $$.paramIds[i] << " (type " << $$.paramTypes[i] << ")" << endl;
        }
        #endif
        $$.paramTypes = $1.paramTypes;
        $$.paramTypes.push_back($3.type);
        $$.paramIds = $1.paramIds;
        $$.paramIds.push_back($3.name);
        $$.quad = buffer->nextQuad();

        // Finish defining params.
        //for (auto symbol_name : current_symbols)
        for (auto iter = current_symbols.rbegin(); iter != current_symbols.rend(); ++iter)
        {
            string& symbol_name = *iter;
            $$.paramTypes.push_back($1.type);
            $$.paramIds.push_back(symbol_name);
            // Offset of the new variable from the frame base.
            symbolTable[symbol_name].offset[currentScopeOffset] = current_param_offset;
            current_param_offset -= 4;
        }
        current_symbols.clear();
    }
    | DCL
    {
        #if DEBUG_PARSER
        cerr << "FUNC_ARGLIST: DCL" << endl; // Add debug print here
        #endif
        $$.quad = buffer->nextQuad();

        // Finish defining params.
        for (auto iter = current_symbols.rbegin(); iter != current_symbols.rend(); ++iter)
        {
            string& symbol_name = *iter;
            $$.paramTypes.push_back($1.type);
            $$.paramIds.push_back(symbol_name);
            // Offset of the new variable from the frame base.
            symbolTable[symbol_name].offset[currentScopeOffset] = current_param_offset;
            current_param_offset -= 4;
        }
        current_symbols.clear();
    }
;

BLK:
    LBRACE STLIST M RBRACE
    {
        #if DEBUG_PARSER
        cerr << "BLK: LBRACE STLIST M RBRACE" << endl; // Add debug print here
        #endif
        $$.quad = $2.quad;
        buffer->backpatch($2.nextList, $3.quad);

        // Reset scope after block ends
        //currentScopeRegsNum = 3;  // Reset register allocation
        // Don't clear symbol table here - only clear at function level
        //buffer->emit(string("RETRN")); // Moved RETRN emission to the end of BLK rule
    }
;

DCL:
    ID COLON TYPE
    {
        #if DEBUG_PARSER
        cerr << "DCL: ID COLON TYPE" << endl;
        #endif
        $$.name = $1.name;
        $$.type = $3.type;
        $$.quad = buffer->nextQuad();

        if (symbolTable.find($1.name) == symbolTable.end())
        {
            Symbol new_symbol;
            new_symbol.type[currentScopeOffset] = $3.type;
            new_symbol.depth = currentScopeOffset;
            symbolTable[$1.name] = new_symbol;
        }
        else if (symbolTable[$1.name].type.find(currentScopeOffset) != symbolTable[$1.name].type.end())
        {
            printSemanticError("redefinition of variable '" + $1.name + "'");
        }
        else
        {
            symbolTable[$1.name].type[currentScopeOffset] = $3.type;
            symbolTable[$1.name].depth = currentScopeOffset;
        }
        current_symbols.push_back($1.name);

        /*// Check redeclaration
        if (symbolTable.find($1.name) != symbolTable.end() &&
            symbolTable[$1.name].type.find(currentScopeOffset) != symbolTable[$1.name].type.end()) {
            printSemanticError("redefinition of variable '" + $1.name + "'");
        }*/

        //// Update symbol table
        //Symbol newSymbol;
        //newSymbol.type[currentScopeOffset] = $3.type;
        //newSymbol.offset[currentScopeOffset] = varOffset;
        //newSymbol.depth = currentScopeOffset;
        //symbolTable[$1.name] = newSymbol;

        //// Update available offset for next variable.
        //++currentScopeOffset;
    }
    | ID COMMA DCL
    {
        #if DEBUG_PARSER
        cerr << "ID COMMA DCL" << endl;
        #endif
        $$.name = $1.name;
        $$.type = $3.type;
        $$.quad = buffer->nextQuad();

        if (symbolTable.find($1.name) == symbolTable.end())
        {
            Symbol new_symbol;
            new_symbol.type[currentScopeOffset] = $3.type;
            new_symbol.depth = currentScopeOffset;
            symbolTable[$1.name] = new_symbol;
        }
        else if (symbolTable[$1.name].type.find(currentScopeOffset) != symbolTable[$1.name].type.end())
        {
            printSemanticError("redefinition of variable '" + $1.name + "'");
        }
        else
        {
            symbolTable[$1.name].type[currentScopeOffset] = $3.type;
            symbolTable[$1.name].depth = currentScopeOffset;
        }
        current_symbols.push_back($1.name);
    }
;

TYPE:
    INT
    {
        #if DEBUG_PARSER
        cerr << "TYPE: INT" << endl;
        #endif
        $$.type = int_;
        $$.quad = buffer->nextQuad();
    }
    | FLOAT
    {
        #if DEBUG_PARSER
        cerr << "TYPE: FLOAT" << endl;
        #endif
        $$.type = float_;
        $$.quad = buffer->nextQuad();
    }
    | VOID
    {
        #if DEBUG_PARSER
        cerr << "TYPE: VOID" << endl;
        #endif
        $$.type = void_t;
        $$.quad = buffer->nextQuad();
    }
;

STLIST:
    STLIST STMT
    {
        #if DEBUG_PARSER
        cerr << "STLIST: STLIST STMT" << endl;
        #endif
        $$.quad = $1.quad;
        buffer->backpatch($1.nextList, $2.quad);
        $$.nextList = $2.nextList;
    }
    | /* empty */
    {
        #if DEBUG_PARSER
        cerr << "STLIST: empty" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        //$$.nextList.clear();
    }
;

STMT:
    DCL SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "STMT: DCL SEMICOLON" << endl;
        #endif
        $$.quad = $1.quad;
        $$.type = $1.type;

        // Finish defining new symbols.
        for (auto symbol_name : current_symbols)
        {
            // Allocate space on the stack for the variable.
            buffer->emit("ADD2I I2 I2 4");
            // Offset of the new variable from the frame base.
            symbolTable[symbol_name].offset[currentScopeOffset] = current_variable_offset;
            current_variable_offset += 4;
        }
        current_symbols.clear();
    }
    | ASSN_STMT
    {
        #if DEBUG_PARSER
        cerr << "STMT: ASSN_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        $$.type = $1.type;
        $$.nextList = $1.nextList;
    }
    | EXP SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "STMT: EXP SEMICOLON" << endl;
        #endif
        $$.quad = $1.quad;
        $$.type = $1.type;
        //$$.nextList.clear();
    }
    | CNTRL_STMT
    {
        #if DEBUG_PARSER
        cerr << "STMT: CNTRL_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        $$.nextList = $1.nextList;
    }
    | READ_STMT
    {
        #if DEBUG_PARSER
        cerr << "STMT: READ_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        //$$.nextList.clear();
    }
    | WRITE_STMT
    {
        #if DEBUG_PARSER
        cerr << "STMT: WRITE_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        //$$.nextList.clear();
    }
    | RETURN_STMT
    {
        #if DEBUG_PARSER
        cerr << "STMT: RETURN_STMT" << endl;
        #endif
        $$.quad = $1.quad;
        //$$.nextList.clear();

        if (!functionTable.empty()) {
            string currentFunc = "";
            for (auto& pair : functionTable) {
                if (pair.second.startLineImplementation != -1) {
                    currentFunc = pair.first;
                    break;
                }
            }

            if (!currentFunc.empty()) {
                if ($1.type != functionTable[currentFunc].returnType) {
                    printSemanticError("return type mismatch in function '" + currentFunc + "'");
                }
            }
        }
    }
    | BLK
    {
        #if DEBUG_PARSER
        cerr << "STMT: BLK" << endl;
        #endif
        $$.quad = $1.quad;
        $$.nextList = $1.nextList;
    }
;

RETURN_STMT:
    RETURN EXP SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "RETURN_STMT: RETURN EXP SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.type = $2.type;  // Use $$ to set the type

        if ($2.type == float_) {
            buffer->emit(string("COPYF F0 F") + to_string($2.RegNum));  // Copy result to F0
        } else {
            buffer->emit(string("COPYI I0 I") + to_string($2.RegNum));  // Copy result to I0
        }
        buffer->emit(string("RETRN"));
    }
    | RETURN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "RETURN_STMT: RETURN SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.type = void_t;
        buffer->emit(string("RETRN"));
    }
;

WRITE_STMT:
    WRITE LPAREN EXP RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "WRITE_STMT: WRITE LPAREN EXP RPAREN SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();

        if ($3.type == float_) {
            buffer->emit(string("PRNTF F") + to_string($3.RegNum));
        } else if ($3.type == int_) {
            buffer->emit(string("PRNTI I") + to_string($3.RegNum));
        } else {
            printSemanticError("invalid type for write statement");
        }
    }
    | WRITE LPAREN STRING_LITERAL RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "WRITE_STMT: WRITE LPAREN STRING_LITERAL RPAREN SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        string str = $3.name;
        str = str.substr(1, str.length() - 2); // Remove surrounding quotes

        for (size_t i = 0; i < str.length(); i++) {
            if (str[i] == '\\') {
                // Handle escape sequences
                if (i+1 >= str.length()) break;
                i++; // Skip backslash

                switch(str[i]) {
                    case 'n':  // Newline
                        buffer->emit("PRNTC 10");
                        break;
                    case '"':  // Handle escaped quotes
                        buffer->emit("PRNTC 34");
                        break;
                    case '\\': // Backslash
                        buffer->emit("PRNTC 92");
                        break;
                    default:   // Unknown escape
                        buffer->emit("PRNTC " + to_string((int)str[i]));
                }
            } else {
                // Regular character
                buffer->emit("PRNTC " + to_string((int)str[i]));
            }
        }
    }
;

READ_STMT:
    READ LPAREN LVAL RPAREN SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "READ_STMT: READ LPAREN LVAL RPAREN SEMICOLON" << endl;
        #endif
        Symbol& sym = symbolTable[$3.name];
        int offset = sym.offset[sym.depth];

        int tempReg = currentScopeRegsNum++;
        // Use sym.type instead of varType
        if (sym.type[sym.depth] == float_) {
            buffer->emit("READF F" + to_string(tempReg));
            buffer->emit("STORF F" + to_string(tempReg) + " I1 " + to_string(offset));
        } else {
            buffer->emit("READI I" + to_string(tempReg));
            buffer->emit("STORI I" + to_string(tempReg) + " I1 " + to_string(offset));
        }
    }
;

ASSN_STMT:
    LVAL ASSIGN EXP SEMICOLON
    {
        #if DEBUG_PARSER
        cerr << "ASSN_STMT: LVAL ASSIGN EXP SEMICOLON" << endl;
        #endif
        $$.quad = buffer->nextQuad();

        Symbol& sym = symbolTable[$1.name];
        Type lvalType = sym.type[sym.depth];
        Type expType = $3.type;

        if (lvalType == void_t || expType == void_t) {
            printSemanticError("void type in assignment");
        }

        // $$: 'LVAL' has a register pointing to that var's memory
        int dest_offset = sym.offset[sym.depth];
        int src_reg   = $3.RegNum;

        if (float_ == lvalType)
        {
            if (int_ == expType)
            {
                int temp_reg = currentScopeRegsNum;
                buffer->emit("CITOF F" + to_string(temp_reg) + " I" + to_string(src_reg));
                src_reg = temp_reg;
                ++currentScopeRegsNum;
            }
            buffer->emit("STORF F" + to_string(src_reg) + " I1 " + to_string(dest_offset));
        }
        else // int_ == lvalType
        {
            if (float_ == expType)
            {
                int temp_reg = currentScopeRegsNum;
                buffer->emit("CFTOI I" + to_string(temp_reg) + " F" + to_string(src_reg));
                src_reg = temp_reg;
                ++currentScopeRegsNum;
            }
            buffer->emit("STORI I" + to_string(src_reg) + " I1 " + to_string(dest_offset));
        }

        $$.type = lvalType;
        $$.RegNum = $1.RegNum;
    }
;

LVAL:
    ID
    {
        #if DEBUG_PARSER
        cerr << "LVAL: ID" << endl;
        #endif
        $$.name = $1.name;
        $$.quad = buffer->nextQuad();

        if (symbolTable.find($1.name) == symbolTable.end()) {
            printSemanticError("undefined variable '" + $1.name + "'");
        }

        Symbol& sym = symbolTable[$1.name];

        if (sym.type.find(sym.depth) == sym.type.end()) {
            printSemanticError("undefined variable '" + $1.name + "' at current scope");
        }
        //$$.type = sym.type[sym.depth];
        //$$.RegNum = currentScopeRegsNum++;
        //buffer->emit("ADD2I I" + to_string($$.RegNum) + " I1 " +
        //            to_string(sym.offset[sym.depth]));
    }
;

CNTRL_STMT:
    IF BEXP THEN M STMT N ELSE M STMT
    {
        #if DEBUG_PARSER
        cerr << "CNTRL_STMT:  IF BEXP THEN M STMT N ELSE M STMT" << endl;
        #endif
        $$.quad = buffer->nextQuad();

        buffer->backpatch($2.trueList, $4.quad);
        buffer->backpatch($2.falseList, $8.quad);

        $$.nextList = merge($4.nextList, $8.nextList);
        $$.nextList.push_back(buffer->nextQuad());
        //vector<int> jumpList = {jumpQuad};
        //$$.nextList = merge($$.nextList, jumpList);
    }
    | IF BEXP THEN M STMT
    {
        #if DEBUG_PARSER
        cerr << "CNTRL_STMT:  IF BEXP THEN M STMT" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        buffer->backpatch($2.trueList, $4.quad);
        $$.nextList = merge($2.falseList, $4.nextList);
    }
    | WHILE M BEXP DO M STMT
    {
        #if DEBUG_PARSER
        cerr << "CNTRL_STMT: WHILE M BEXP DO M STMT" << endl;
        #endif
        buffer->backpatch($6.nextList, $2.quad);
        buffer->backpatch($3.trueList, $5.quad);
        $$.nextList = $3.falseList;
        buffer->emit("UJUMP " + to_string($2.quad));
    }
;

BEXP:
    BEXP OR BEXP
    {
        #if DEBUG_PARSER
        cerr << "BEXP: BEXP OR BEXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        buffer->backpatch($1.falseList, $3.quad);
        $$.trueList = merge($1.trueList, $3.trueList);
        $$.falseList = $3.falseList;
    }
    | BEXP AND BEXP
    {
        #if DEBUG_PARSER
        cerr << "BEXP: BEXP AND BEXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        buffer->backpatch($1.trueList, $3.quad);
        $$.falseList = merge($1.falseList, $3.falseList);
        $$.trueList = $3.trueList;
    }
    | NOT BEXP
    {
        #if DEBUG_PARSER
        cerr << "BEXP: NOT BEXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.trueList = $2.falseList;
        $$.falseList = $2.trueList;
    }
    | EXP RELOP EXP
    {
        #if DEBUG_PARSER
        cerr << "BEXP: EXP RELOP EXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        if ($1.type != $3.type) {
            printSemanticError("type mismatch in relational expression");
        }

        $$.RegNum = currentScopeRegsNum++;
        string regType = ($1.type == float_) ? "F" : "I";
        string opName;

        if ($2.name == "==")       opName = "SEQU";
        else if ($2.name == "<>")  opName = "SNEQ";
        else if ($2.name == "<")   opName = "SLET";
        else if ($2.name == ">")   opName = "SGRT";
        // greater/less-equal use negation of the operators less/greater.
        else if ($2.name == ">=")  opName = "SLET";
        else if ($2.name == "<=")  opName = "SGRT";

        buffer->emit(opName + regType + " " + regType + to_string($$.RegNum) +
                    " " + regType + to_string($1.RegNum) +
                    " " + regType + to_string($3.RegNum));

        $$.falseList.push_back(buffer->nextQuad());
        if ($2.name == "<>" || $2.name == "==" ||
            $2.name == "<" | $2.name == ">")
        {
            buffer->emit("BREQZ " + regType + to_string($$.RegNum) + " ");
        }
        else if ($2.name == ">=" || $2.name == "<=")
        {
            buffer->emit("BNEQZ " + regType + to_string($$.RegNum) + " ");
        }
        else
        {
            printOperationalError("Invalid relative operator.");
        }

        $$.trueList.push_back(buffer->nextQuad());
        buffer->emit("UJUMP ");
    }
    | LPAREN BEXP RPAREN
    {
        #if DEBUG_PARSER
        cerr << "BEXP: LPAREN BEXP RPAREN" << endl;
        #endif
        $$.quad = $2.quad;
        $$.trueList = $2.trueList;
        $$.falseList = $2.falseList;
    }
;

EXP:
    EXP ADDOP EXP
    {
        #if DEBUG_PARSER
        cerr << "EXP: EXP ADDOP EXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        if ($1.type == void_t || $3.type == void_t) {
            printSemanticError("void type in arithmetic expression");
        }
        $$.type = ($1.type == float_ || $3.type == float_) ? float_ : int_;
        $$.RegNum = currentScopeRegsNum++;
        int src_1 = $1.RegNum;
        int src_2 = $3.RegNum;

        if ($$.type == float_) {
            if ($1.type == int_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit(string("CITOF F") + to_string(tempReg) + string(" I") + to_string($1.RegNum));
                src_1 = tempReg;
            }
            if ($3.type == int_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit(string("CITOF F") + to_string(tempReg) + string(" I") + to_string($3.RegNum));
                src_2 = tempReg;
            }

            buffer->emit((($2.name == "+") ? string("ADD2F") : string("SUBTF")) +
                        string(" F") + to_string($$.RegNum) +
                        string(" F") + to_string(src_1) +
                        string(" F") + to_string(src_2));
        } else {
            buffer->emit((($2.name == "+") ? string("ADD2I") : string("SUBTI")) +
                        string(" I") + to_string($$.RegNum) +
                        string(" I") + to_string(src_1) +
                        string(" I") + to_string(src_2));
        }
    }
    | EXP MULOP EXP
    {
        #if DEBUG_PARSER
        cerr << "EXP: EXP MULOP EXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        if ($1.type == void_t || $3.type == void_t) {
            printSemanticError("void type in arithmetic expression");
        }

        // Determine result type (float if either operand is float)
        $$.type = ($1.type == float_ || $3.type == float_) ? float_ : int_;
        $$.RegNum = currentScopeRegsNum++;

        // Handle type conversions
        int src_1 = $1.RegNum;
        int src_2 = $3.RegNum;

        if ($$.type == float_) {
            // Convert left operand to float if needed
            if ($1.type == int_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit("CITOF F" + to_string(tempReg) + " I" + to_string(src_1));
                src_1 = tempReg;
            }
            // Convert right operand to float if needed
            if ($3.type == int_) {
                int tempReg = currentScopeRegsNum++;
                buffer->emit("CITOF F" + to_string(tempReg) + " I" + to_string(src_2));
                src_2 = tempReg;
            }

            // Emit float operation
            if ($2.name == "*") {
                buffer->emit("MULTF F" + to_string($$.RegNum) + " F" + to_string(src_1) + " F" + to_string(src_2));
            } else { // division
                buffer->emit("DIVDF F" + to_string($$.RegNum) + " F" + to_string(src_1) + " F" + to_string(src_2));
            }
        } else {
            // Emit integer operation
            if ($2.name == "*") {
                buffer->emit("MULTI I" + to_string($$.RegNum) + " I" + to_string(src_1) + " I" + to_string(src_2));
            } else { // division
                buffer->emit("DIVDI I" + to_string($$.RegNum) + " I" + to_string(src_1) + " I" + to_string(src_2));
            }
        }
    }
    | LPAREN EXP RPAREN
    {
        #if DEBUG_PARSER
        cerr << "EXP: LPAREN EXP RPAREN" << endl;
        #endif
        $$ = $2;  // Pass through all attributes
    }
    | LPAREN TYPE RPAREN EXP
    {
        #if DEBUG_PARSER
        cerr << "EXP: LPAREN TYPE RPAREN EXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.type = $2.type;
        $$.RegNum = currentScopeRegsNum++;

        if ($2.type == float_ && $4.type == int_) {
            buffer->emit(string("CITOF F") + to_string($$.RegNum) + string(" I") + to_string($4.RegNum));
        } else if ($2.type == int_ && $4.type == float_) {
            buffer->emit(string("CFTOI I") + to_string($$.RegNum) + string(" F") + to_string($4.RegNum));
        } else {
            if ($2.type == float_) {
                buffer->emit(string("COPYF F") + to_string($$.RegNum) + string(" F") + to_string($4.RegNum));
            } else {
                buffer->emit(string("COPYI I") + to_string($$.RegNum) + string(" I") + to_string($4.RegNum));
            }
        }
    }
    | ID
    {
        #if DEBUG_PARSER
        cerr << "EXP: ID" << endl;
        #endif
        $$.quad = buffer->nextQuad();

        if (symbolTable.find($1.name) == symbolTable.end()) {
            printSemanticError("unisDefined variable '" + $1.name + "'");
        }

        Symbol& sym = symbolTable[$1.name];
        if (sym.type.find(sym.depth) == sym.type.end()) {
            printSemanticError("unisDefined variable '" + $1.name + "' at current scope");
        }

        $$.type = sym.type[sym.depth];
        $$.RegNum = currentScopeRegsNum++;
        $$.name = $1.name;

        if ($$.type == float_) {
            buffer->emit(string("LOADF F") + to_string($$.RegNum) + string(" I1 ") + to_string(sym.offset[sym.depth])); // Load from float
        } else {
            buffer->emit(string("LOADI I") + to_string($$.RegNum) + string(" I1 ") + to_string(sym.offset[sym.depth]));   // Load from int
        }
    }
    | NUM
    {
        #if DEBUG_PARSER
        cerr << "EXP: NUM" << endl;
        #endif
        $$ = $1;
    }
    | CALL
    {
        #if DEBUG_PARSER
        cerr << "EXP: CALL" << endl;
        #endif
        $$ = $1;
    }
    | VA_MATERIALISE
    {
        #if DEBUG_PARSER
        cerr << "EXP: VA_MATERIALISE" << endl;
        #endif
        $$ = $1;
    }
;

NUM:
    INTEGERNUM
    {
        #if DEBUG_PARSER
        cerr << "NUM: INTEGERNUM" << endl;
        #endif
        $$.type = int_;
        $$.RegNum = currentScopeRegsNum++;
        buffer->emit(string("COPYI I") + to_string($$.RegNum) + string(" ") + $1.name);
        $$.quad = buffer->nextQuad();
    }
    | REALNUM
    {
        #if DEBUG_PARSER
        cerr << "NUM: REALNUM" << endl;
        #endif
        $$.type = float_;
        $$.RegNum = currentScopeRegsNum++;
        buffer->emit(string("COPYF F") + to_string($$.RegNum) + string(" ") + $1.name);
        $$.quad = buffer->nextQuad();
    }
;

CALL:
    ID LPAREN CALL_ARGS RPAREN
    {
        #if DEBUG_PARSER
        cerr << "CALL: ID LPAREN CALL_ARGS RPAREN" << endl;
        #endif
        $$.quad = buffer->nextQuad();

        if (functionTable.find($1.name) == functionTable.end()) {
            printSemanticError("unisDefined function '" + $1.name + "'");
        }

        Function& func = functionTable[$1.name];

        for (size_t i = 0; i < $3.paramTypes.size() && i < func.paramTypes.size(); i++) {
            if ($3.paramTypes[i] == int_ && func.paramTypes[i] == float_) {
                int newReg = currentScopeRegsNum++;
                buffer->emit(string("CITOF F") + to_string(newReg) + string(" I") + to_string($3.paramRegs[i]));
                $3.paramRegs[i] = newReg;  // Update the parameter register
            }
        }

        int callQuad = buffer->nextQuad();  // Line number of JLINK
        buffer->emit("JLINK " + $1.name);   // Emit call instruction
        func.callingLines.push_back(callQuad); // Track call site

        $$.type = func.returnType;
        if ($$.type != void_t) {  // Use $$ for return value handling
            $$.RegNum = currentScopeRegsNum++;
            if ($$.type == float_) {
                buffer->emit(string("COPYF F") + to_string($$.RegNum) + string(" F0"));
            } else {
                buffer->emit(string("COPYI I") + to_string($$.RegNum) + string(" I0"));
            }
        }
    }
;

VA_MATERIALISE:
    VA_ARG LPAREN TYPE COMMA EXP RPAREN
    {
        #if DEBUG_PARSER
        cerr << "VA_MATERIALISE: VA_ARG LPAREN TYPE COMMA EXP RPAREN" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.type = $3.type;
        $$.RegNum = currentScopeRegsNum++;
        std::vector<int> runtime_errors;

        // Runtime check: 0 <= index < n
        int tempReg1 = currentScopeRegsNum++;
        int tempReg2 = currentScopeRegsNum++;

        // Check index >= 0
        buffer->emit("SLETI I" + to_string(tempReg1) + " I" + to_string($5.RegNum) + " 0");
        runtime_errors.push_back(buffer->nextQuad());
        buffer->emit("BNEQZ I" + to_string(tempReg1) + " "); // Jump if index < 0

        // Check index < n (n is in I3 as defined in function declaration)
        buffer->emit("SLETI I" + to_string(tempReg2) + " I3 I" + to_string($5.RegNum));
        runtime_errors.push_back(buffer->nextQuad());
        buffer->emit("BREQZ I" + to_string(tempReg2) + " "); // Jump if index >= n

        // Proceed if valid
        int va_param_index = currentScopeRegsNum++;
        int va_param_offset = currentScopeRegsNum++;
        buffer->emit("ADD2I I" + to_string(va_param_index) + " I3 I" + to_string($5.RegNum));
        buffer->emit("MULTI I" + to_string(va_param_offset) + " I" + to_string(va_param_index) + " 4"); // turn index into offset
        buffer->emit("LOADI I" + to_string($$.RegNum) + " I3 I" + to_string(va_param_offset));

        // Error handling block
        int runtime_error_skip = buffer->nextQuad();
        buffer->emit("UJUMP ");
        int runtime_error_print = buffer->nextQuad();
        buffer->emit("PRNTC 82");   // R
        buffer->emit("PRNTC 117");  // u
        buffer->emit("PRNTC 110");  // n
        buffer->emit("PRNTC 116");  // t
        buffer->emit("PRNTC 105");  // i
        buffer->emit("PRNTC 109");  // m
        buffer->emit("PRNTC 101");  // e
        buffer->emit("PRNTC 32");   //
        buffer->emit("PRNTC 101");  // e
        buffer->emit("PRNTC 114");  // r
        buffer->emit("PRNTC 114");  // r
        buffer->emit("PRNTC 111");  // o
        buffer->emit("PRNTC 114");  // r
        buffer->emit("PRNTC 33");   // !
        buffer->emit("PRNTC 10");   // \n
        buffer->emit("HALT");
        buffer->backpatch(runtime_errors, runtime_error_print);
        $$.nextList.push_back(runtime_error_skip); // Skip if nothing bad happened.
        buffer->backpatch($$.nextList, buffer->nextQuad());
    }
;

CALL_ARGS:
    CALL_ARGLIST
    {
        #if DEBUG_PARSER
        cerr << "CALL_ARGS: CALL_ARGLIST" << endl;
        #endif
        $$ = $1;
    }
    | /* empty */
    {
        #if DEBUG_PARSER
        cerr << "CALL_ARGS: empty" << endl;
        #endif
        $$.paramTypes.clear();
        $$.paramRegs.clear();
        $$.quad = buffer->nextQuad();
    }
;

CALL_ARGLIST:
    CALL_ARGLIST COMMA EXP
    {
        #if DEBUG_PARSER
        cerr << "CALL_ARGS: CALL_ARGLIST COMMA EXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.paramTypes = $1.paramTypes;
        $$.paramRegs = $1.paramRegs;
        $$.paramTypes.push_back($3.type);
        $$.paramRegs.push_back($3.RegNum);

        /*if ($3.type == int_) { // Int to Float Conversion if needed
            int newReg = currentScopeRegsNum++;
            buffer->emit(string("STOREI2F I") + to_string($3.RegNum) + string(" F") + to_string(newReg));
            $$.paramRegs.back() = newReg;
        }*/
    }
    | EXP
    {
        #if DEBUG_PARSER
        cerr << "CALL_ARGS: EXP" << endl;
        #endif
        $$.quad = buffer->nextQuad();
        $$.paramTypes.push_back($1.type);
        $$.paramRegs.push_back($1.RegNum);

        /*if ($1.type == int_) { // Int to Float Conversion if needed
            int newReg = currentScopeRegsNum++;
            buffer->emit(string("STOREI2F I") + to_string($1.RegNum) + string(" F") + to_string(newReg));
            $$.paramRegs.back() = newReg;
        }*/
    }
;

M :
    /* EPSILON */
    {
        //#if DEBUG_PARSER
        //buffer->emit(";; M -> epsilon ;;");
        //#endif
        $$.quad = buffer->nextQuad();
    }
;


N :
    /* EPSILON */
    {
        $$.nextList.push_back(buffer->nextQuad());
        buffer->emit("UJUMP ");
    }
;
%%

int main(int argc, char* argv[]) {
    // Check number of arguments
    if (argc != 2) {
        cerr << "Operational error: invalid number of arguments" << endl;
        exit(OPERATIONAL_ERROR);
    }

    string inputFileName = argv[1];

    // Check file extension
    size_t lastindex = inputFileName.find_last_of(".");
    if (lastindex == string::npos || inputFileName.substr(lastindex) != ".cmm") {
        cerr << "Operational error: invalid file type. expecting '.cmm' extension" << endl;
        exit(OPERATIONAL_ERROR);
    }

    // Open input file
    extern FILE* yyin;
    yyin = fopen(argv[1], "r");
    if (yyin == NULL) {
        cerr << "Operational error: cannot open input file" << endl;
        exit(OPERATIONAL_ERROR);
    }

    // Initialize buffer
    buffer = new Buffer();

    // Parse input
    if (yyparse() != 0) {
        // Error handling is done in yyerror
        fclose(yyin);
        yylex_destroy();
        delete buffer;
        return 1;
    }

    // Generate header
    string header = "<header>\n";

    // Generate unimplemented functions list
    string uimp = "<unimplemented>";
    for (const auto& func : functionTable) {
        if (func.second.startLineImplementation == -1) {
            uimp += " " + func.first;
            for (int line : func.second.callingLines) {
                uimp += "," + to_string(line);
            }
        }
    }
    header += uimp + "\n";

    // Generate implemented functions list
    string imp = "<implemented>";
    for (const auto& func : functionTable) {
        if (func.second.startLineImplementation != -1) {
            imp += " " + func.first + "," + to_string(func.second.startLineImplementation);
        }
    }
    header += imp + "\n";
    header += "</header>";

    // Add header to beginning of buffer
    buffer->frontEmit(header);

    // Generate output file name
    string outputFileName = inputFileName.substr(0, lastindex) + ".rsk";
    size_t found = outputFileName.find_last_of("/\\");
    if (found != string::npos) {
        outputFileName = outputFileName.substr(found + 1);
    }

    // Write to output file
    ofstream rskFile(outputFileName);
    if (!rskFile.is_open()) {
        cerr << "Operational error: cannot create output file" << endl;
        fclose(yyin);
        yylex_destroy();
        delete buffer;
        exit(OPERATIONAL_ERROR);
    }

    rskFile << buffer->printBuffer();
    rskFile.close();
    fclose(yyin);
    yylex_destroy();

    delete buffer;
    return 0;
}

void yyerror(const char *s) {
    cerr << "Syntax error: '" << yytext << "' in line number " << yylineno << endl;
    exit(SYNTAX_ERROR);
}

int printOperationalError (string err) {
    cerr << "Operational error: " << err << endl;
    exit(OPERATIONAL_ERROR);
}

int printSemanticError (string err) {
    cerr << "Semantic error: " << err << " in line number " << yylineno << endl;
    exit(SEMANTIC_ERROR);
}
