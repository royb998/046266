%{

#include <iostream>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <vector>
#include <string>
#include <map>
#include "part3_helpers.hpp"

#define DEBUG_PARSER 0

#ifdef __cplusplus
extern "C" {
#endif

#if defined(FLEX_SCANNER) || defined(FLEXPP_SCANNER)
extern int yylex_destroy(void);
#else
#define yylex_destroy() (0)
#endif

#ifdef __cplusplus
}
#endif

int printOperationalError (string err);
int printSemanticError(string err);

typedef yystype YYSTYPE;
extern int yylineno;
extern char* yytext;
int yylex(void);
void yyerror(const char *s);

// Global variables
extern Buffer* buffer;
extern map<string, Symbol> symbolTable;
extern map<string, Function> functionTable;
int currentScopeRegsNum = 3;
int currentScopeOffset = 0;
Type currentReturnType;
bool inVariadicFunction = false;
int current_variable_offset = 0;
int current_param_offset = -8;
vector<string> current_symbols;
%}

/* Keywords and operators */
%token  INT FLOAT VOID
%token  RETURN WRITE READ
%token  WHILE IF THEN ELSE DO
%token  ASSIGN VA_ARG ELLIPSIS
%token  OR AND NOT
%token  ID INTEGERNUM REALNUM STRING_LITERAL RELOP ADDOP MULOP
%token  COMMA SEMICOLON LPAREN RPAREN LBRACE RBRACE COLON

/* Operator precedence and associativity */
%right ASSIGN
%right IF THEN ELSE
%left OR
%left AND
%left RELOP
%left ADDOP
%left MULOP
%right NOT
%left LPAREN
%left RPAREN
%left LBRACE
%left RBRACE
%left COLON
%left SEMICOLON
%%

PROGRAM:
    FDEFS
    { 
        // Backpatch function calls. This ensures that forward-declared functions have their
        // addresses properly resolved in jump instructions
        for(auto& func : functionTable) {
            buffer->backpatch(func.second.callingLines, func.second.startLineImplementation);
        }
    }
;

FDEFS:
    FDEFS FUNC_DEF_API BLK
    {
        buffer->backpatch($3.nextList, buffer->nextQuad());
        // Emit a return instruction at the end of each function
        buffer->emit("RETRN");

        // Reset state for the next function definition
        currentScopeRegsNum = 3;
        currentScopeOffset = 0;
        current_variable_offset = 0;
        current_param_offset = -8;
        inVariadicFunction = false;

        // Clear the symbol table for the next function, as local symbols are no longer in scope
        symbolTable.clear();
        $2.paramTypes.clear();
    }
    | FDEFS FUNC_DEC_API { }
    | /* empty */ { }
;

FUNC_DEC_API:
    TYPE ID LPAREN RPAREN SEMICOLON
    {
        // Store information about the declared function
        $$.name = $2.name;
        $$.type = $1.type;
        $$.quad = buffer->nextQuad();

        // Check for conflicts with existing function declarations
        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            // Ensure return type matches previous declarations
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" +
                                   $2.name + "'");
            }
            // Ensure parameter types match previous declarations
            if (!existingFunc.paramTypes.empty()) {
                printSemanticError("conflicting parameter types for function declaration '" +
                                    $2.name + "'");
            }
        } else {
            // Create a new function entry in the table
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.startLineImplementation = -1; // Indicate that the function is declared but not defined yet
            newFunc.indexNumVAParams = -1;
            newFunc.startIndexVAParams = -1;
            newFunc.isDefined = false;
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
        // Clear the symbol table as we exit the function declaration scope
        symbolTable.clear();
        current_param_offset = -8;
    }
    | TYPE ID LPAREN FUNC_ARGLIST RPAREN SEMICOLON
    {
        // Store information about the declared function
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        // Check for conflicts with existing function declarations
        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            // Ensure return type matches previous declarations
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" + 
                                    $2.name + "'");
            }
            // Ensure parameter types match previous declarations
            if (existingFunc.paramTypes != $4.paramTypes) {
                printSemanticError("conflicting parameter types for function declaration '" +
                                   $2.name + "'");
            }
        } else {
            // Create a new function entry in the table
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.startLineImplementation = -1; // Indicate that the function is declared but not defined yet
            newFunc.indexNumVAParams = -1;
            newFunc.startIndexVAParams = -1;
            newFunc.isDefined = false;
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }

        // Clear the symbol table as we exit the function declaration scope
        symbolTable.clear();
        current_param_offset = -8;
    }
    | TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN SEMICOLON
    {
        // Store information about the declared variadic function
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        // Ensure there's at least one named parameter before the ellipsis, and it's an int
        if ($4.paramTypes.empty() || $4.paramTypes.front() != int_) {
            printSemanticError("missing or non-int last named parameter before '...'");
        }

        // Check for conflicts with existing function declarations
        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            // Ensure return type matches previous declarations
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for variadic function declaration '" +
                                    $2.name + "'");
            }
            // Ensure parameter types match previous declarations
            if (existingFunc.paramTypes != $4.paramTypes) {
                printSemanticError("conflicting parameter types for variadic function declaration '" 
                                    + $2.name + "'");
            }
        } else {
            // Create a new function entry in the table for the variadic function
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.startLineImplementation = -1; // Indicate that the function is declared but not defined yet
            
            // Store indices for managing variadic arguments
            newFunc.indexNumVAParams = $4.paramTypes.size();
            newFunc.startIndexVAParams = newFunc.indexNumVAParams + 1;
            newFunc.isDefined = false;
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }

        // Clear the symbol table as we exit the function declaration scope
        symbolTable.clear();
        current_param_offset = -8;
    }
;

FUNC_DEF_API:
    TYPE ID LPAREN RPAREN
    {
        // Store information about the defined function
        $$.name = $2.name;
        $$.type = $1.type;
        $$.quad = buffer->nextQuad();

        // Special case: 'main' must return 'void'
        if ($2.name == "main" && $1.type != void_t) {
            printSemanticError("main function must return void");
        }

        // Check for conflicts with existing function declarations or definitions
        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];

            // Ensure return type matches previous declarations
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" + $2.name + "'");
            }
            // Check for redefinition
            if (existingFunc.isDefined == true) {
                printSemanticError("2 redefinition of function '" + $2.name + "'");
            } else {
                // Mark the function as defined and record the start line of the implementation
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            // Create a new function entry in the table
            Function newFunc;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.startLineImplementation = $$.quad;
            newFunc.isDefined = true; 
            newFunc.indexNumVAParams = -1;
            newFunc.startIndexVAParams = -1;
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));

        }
        
        // Initialize parameter offsets
        current_param_offset = -8;
        for (size_t i = 0; i < $4.paramIds.size(); i++) {
            symbolTable[$4.paramIds[i]].offset[currentScopeOffset] = current_param_offset;
            current_param_offset -= 4;
        }
    }
    | TYPE ID LPAREN FUNC_ARGLIST RPAREN
    {
        // Store information about the defined function
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        // Check for conflicts with existing function declarations or definitions
        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            // Ensure return type matches previous declarations
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" + $2.name + "'");
            }
            // Check for redefinition
            if (existingFunc.isDefined == true) {
                printSemanticError("3 redefinition of function '" + $2.name + "'");
            } else {
                // Mark the function as defined and record the start line of the implementation
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            // Create a new function entry in the table
            Function newFunc;
            newFunc.isDefined = true;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            newFunc.indexNumVAParams = -1;
            newFunc.startIndexVAParams = -1;
            newFunc.startLineImplementation = buffer->nextQuad();
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }
    }
    | TYPE ID LPAREN FUNC_ARGLIST COMMA ELLIPSIS RPAREN
    {
        // Store information about the defined variadic function
        $$.name = $2.name;
        $$.type = $1.type;
        $$.paramTypes = $4.paramTypes;
        $$.paramIds = $4.paramIds;
        $$.quad = buffer->nextQuad();

        // Ensure there's at least one named parameter before the ellipsis, and it's an int
        if ($4.paramTypes.empty() || $4.paramTypes.front() != int_) {
            printSemanticError("missing or non-int last named parameter before '...'");
        }

        // Check for conflicts with existing function declarations or definitions
        if (functionTable.find($2.name) != functionTable.end()) {
            Function& existingFunc = functionTable[$2.name];
            // Ensure return type matches previous declarations
            if (existingFunc.returnType != $1.type) {
                printSemanticError("conflicting return type for function declaration '" + $2.name + "'");
            }
            // Check for redefinition
             if (existingFunc.isDefined) {
                printSemanticError("4 redefinition of function '" + $2.name + "'");
            } else {
                // Mark the function as defined and record the start line of the implementation
                existingFunc.startLineImplementation = buffer->nextQuad();
                existingFunc.isDefined = true;
            }
        } else {
            // Create a new function entry in the table for the variadic function
            Function newFunc;
            inVariadicFunction = true;
            newFunc.isDefined = true;
            newFunc.returnType = $1.type;
            newFunc.paramTypes = $4.paramTypes;
            newFunc.paramIds = $4.paramIds;
            
            // Store indices for managing variadic arguments
            newFunc.indexNumVAParams = $4.paramTypes.size();
            newFunc.startIndexVAParams = newFunc.indexNumVAParams + 1;
            newFunc.startLineImplementation = buffer->nextQuad();
            functionTable.insert(std::pair<string,Function>($2.name, newFunc));
        }

        // Special handling for variadic functions: store the number of variadic arguments in I3
        int num_va_params_index = $4.paramTypes.size() - 1;
        int num_va_params_offset = -8 - (4 * num_va_params_index);
        if (3 != currentScopeRegsNum) {
            printOperationalError("Something went wrong. VA num reg should be 3.");
        }
        ++currentScopeRegsNum; // Use the next available register
        // Store the offset to the number of variadic arguments in I3
        buffer->emit("COPYI I3 " + to_string(num_va_params_offset));
        inVariadicFunction = true;
    }
;

FUNC_ARGLIST:
    FUNC_ARGLIST COMMA DCL
    {
        // Inherit parameter types and IDs from the previous part of the argument list
        $$.paramTypes = $1.paramTypes;
        $$.paramIds = $1.paramIds;
        $$.quad = buffer->nextQuad();

        // Process the newly declared parameters
        for (auto symbol_name : current_symbols) {
            // Add the type and ID of each parameter to the lists
            $$.paramTypes.push_back($1.type);
            $$.paramIds.push_back(symbol_name);
            
            // Calculate and store the offset of the new parameter from the frame base
            symbolTable[symbol_name].offset[currentScopeOffset] = current_param_offset;
            current_param_offset -= 4; // Decrement the offset for the next parameter (stack grows downwards)
        }
        current_symbols.clear(); // Clear the list of currently processed symbols
    }
    | DCL
    {
        $$.quad = buffer->nextQuad();

        // Process the newly declared parameters (base case for the argument list)
        for (auto iter = current_symbols.rbegin(); iter != current_symbols.rend(); ++iter) {
            string& symbol_name = *iter;
            // Add the type and ID of each parameter to the lists
            $$.paramTypes.push_back($1.type);
            $$.paramIds.push_back(symbol_name);
            
            // Calculate and store the offset of the new parameter from the frame base
            symbolTable[symbol_name].offset[currentScopeOffset] = current_param_offset;
            current_param_offset -= 4; // Decrement the offset for the next parameter (stack grows downwards)
        }
        current_symbols.clear(); // Clear the list of currently processed symbols
    }
;

BLK:
    OPEN_SCOPE LBRACE STLIST M RBRACE CLOSE_SCOPE
    {
        // Propagate the quad and next list information from the block's statement list
        $$.quad = $2.quad;
        buffer->backpatch($2.nextList, $3.quad);
    }
;

OPEN_SCOPE:
    /* EPSILON */
    {
        // Increment the scope level when entering a new block
        ++currentScopeOffset;
    }
;

CLOSE_SCOPE:
    /* EPSILON */
    {
        // Remove symbols from the current scope when exiting a block
        for (auto& symbol : symbolTable) {
            symbol.second.type.erase(currentScopeOffset);
            symbol.second.offset.erase(currentScopeOffset);
            // Update the symbol's depth to the maximum scope level it was defined in
            size_t new_depth = 0;
            for (auto& offset : symbol.second.offset)
            {
                if (offset.first > new_depth)
                {
                    new_depth = offset.first;
                }
            }
            symbol.second.depth = new_depth;
        }

        // Decrement the scope level
        --currentScopeOffset;
    }

DCL:
    ID COLON TYPE
    {
        // Store information about the declared variable
        $$.name = $1.name;
        $$.type = $3.type;
        $$.quad = buffer->nextQuad();

        // 'void' type is not allowed for variable declarations
        if ($3.type == void_t) {
            printSemanticError("void is not a valid type for variable declaration");
        }

        // Check for redefinition within the current scope
        if (symbolTable.find($1.name) == symbolTable.end()) {
            // Create a new symbol entry if it doesn't exist
            Symbol new_symbol;
            new_symbol.type[currentScopeOffset] = $3.type;
            new_symbol.depth = currentScopeOffset;
            symbolTable[$1.name] = new_symbol;
        }
        else if (symbolTable[$1.name].type.find(currentScopeOffset) != symbolTable[$1.name].type.end()) {
            printSemanticError("redefinition of variable '" + $1.name + "'");
        } else {
            // Add the type information for the current scope level
            symbolTable[$1.name].type[currentScopeOffset] = $3.type;
            symbolTable[$1.name].depth = currentScopeOffset;
        }
        // Add the symbol to the list of currently processed symbols
        current_symbols.push_back($1.name);
    }
    | ID COMMA DCL
    {
        // Store information about the declared variable
        $$.name = $1.name;
        $$.type = $3.type;
        $$.quad = buffer->nextQuad();

        // Check for redefinition within the current scope
        if (symbolTable.find($1.name) == symbolTable.end()) {
            // Create a new symbol entry if it doesn't exist
            Symbol new_symbol;
            new_symbol.type[currentScopeOffset] = $3.type;
            new_symbol.depth = currentScopeOffset;
            symbolTable[$1.name] = new_symbol;
        } else if (symbolTable[$1.name].type.find(currentScopeOffset) != symbolTable[$1.name].type.end())
        {
            printSemanticError("redefinition of variable '" + $1.name + "'");
        } else {
            // Add the type information for the current scope level
            symbolTable[$1.name].type[currentScopeOffset] = $3.type;
            symbolTable[$1.name].depth = currentScopeOffset;
        }
        // Add the symbol to the list of currently processed symbols
        current_symbols.push_back($1.name);
    }
;

TYPE:
    INT
    {
        // Set the type to 'int'
        $$.type = int_;
        $$.quad = buffer->nextQuad();
    }
    | FLOAT
    {
        // Set the type to 'float'
        $$.type = float_;
        $$.quad = buffer->nextQuad();
    }
    | VOID
    {
        // Set the type to 'void'
        $$.type = void_t;
        $$.quad = buffer->nextQuad();
    }
;

STLIST:
    STLIST STMT { }
    | /* empty */
    {
        $$.nextList.clear();
    }
;

STMT:
    DCL SEMICOLON
    {
        $$.quad = $1.quad;
        $$.type = $1.type;

        // Finish defining new symbols.
        for (auto symbol_name : current_symbols) {
            // Allocate space on the stack for the variable.
            buffer->emit("ADD2I I2 I2 4");
            
            // Offset of the new variable from the frame base.
            symbolTable[symbol_name].offset[currentScopeOffset] = current_variable_offset;
            current_variable_offset += 4;
        }
        current_symbols.clear();
    }
    | ASSN_STMT { }
    | EXP SEMICOLON { }
    | CNTRL_STMT M
    {
        // Backpatch the control statement's 'next list' to the next quad after the statement
        buffer->backpatch($1.nextList, $2.quad);
    }
    | READ_STMT { }
    | WRITE_STMT { }
    | RETURN_STMT { }
    | BLK { }
;

RETURN_STMT:
    RETURN EXP SEMICOLON
    {
        $$.quad = buffer->nextQuad();
        $$.type = $2.type;  

        // Store the return value in the designated return value location (offset -4 from the frame pointer)
        if ($2.type == float_) {
            buffer->emit(string("STORF F" + to_string($2.RegNum) + " F1 -4"));
        } else {
            buffer->emit(string("STORI I" + to_string($2.RegNum) + " I1 -4"));  
        }
        buffer->emit("RETRN");
    }
    | RETURN SEMICOLON
    {
        // Set the type to 'void' for return statements without an expression
        $$.type = void_t;
        buffer->emit("RETRN");
    }
;

WRITE_STMT:
    WRITE LPAREN EXP RPAREN SEMICOLON
    {
        $$.quad = buffer->nextQuad();

        // Emit code to print the expression based on its type
        if ($3.type == float_) {
            buffer->emit(string("PRNTF F") + to_string($3.RegNum));
        } else if ($3.type == int_) {
            buffer->emit(string("PRNTI I") + to_string($3.RegNum));
        } else {
            printSemanticError("invalid type for write statement");
        }
    }
    | WRITE LPAREN STRING_LITERAL RPAREN SEMICOLON
    {
        $$.quad = buffer->nextQuad();
        string str = $3.name;
        str = str.substr(1, str.length() - 2); // Remove surrounding quotes

        // Emit code to print each character of the string literal
        for (size_t i = 0; i < str.length(); i++) {
            if (str[i] == '\\') {
                // Handle escape sequences
                if (i+1 >= str.length()) break;
                i++; // Skip backslash

                switch(str[i]) {
                    case 'n':  // Newline
                        buffer->emit("PRNTC 10");
                        break;
                    case '"':  // Handle escaped quotes
                        buffer->emit("PRNTC 34");
                        break;
                    case 't': // Tab
                        buffer->emit("PRNTC 9");
                        break;
                    default:   // Unknown escape
                        buffer->emit("PRNTC " + to_string((int)str[i]));
                }
            } else {
                // Regular character
                buffer->emit("PRNTC " + to_string((int)str[i]));
            }
        }
    }
;

READ_STMT:
    READ LPAREN LVAL RPAREN SEMICOLON
    {
        // Get the symbol corresponding to the lvalue
        Symbol& sym = symbolTable[$3.name];
        int offset = sym.offset[sym.depth];
        int tempReg = currentScopeRegsNum++;

        // Emit code to read input based on the lvalue's type
        if (sym.type[sym.depth] == float_) {
            buffer->emit("READF F" + to_string(tempReg));

            // Convert I1 (frame pointer) to a float register for addressing
            int floatBaseReg = currentScopeRegsNum++;
            buffer->emit("CITOF F" + to_string(floatBaseReg) + " I1");

            // Store the float value in memory at the calculated offset
            buffer->emit("STORF F" + to_string(tempReg) + " F" + to_string(floatBaseReg) + " " + to_string(offset));
        } else {
            buffer->emit("READI I" + to_string(tempReg));
            // Store the integer value in memory at the calculated offset
            buffer->emit("STORI I" + to_string(tempReg) + " I1 " + to_string(offset));
        }
    }
;

ASSN_STMT:
    LVAL ASSIGN EXP SEMICOLON
    {
        // Get the symbol corresponding to the lvalue
        Symbol& sym = symbolTable[$1.name];
        Type lvalType = sym.type[sym.depth];
        Type expType = $3.type;

        // Check for void type errors in assignment
        if (lvalType == void_t || expType == void_t) {
            printSemanticError("void type in assignment");
        }

        // Check for implicit casting and report a semantic error if types are incompatible
        if (lvalType != expType) {
            printSemanticError("incompatible type of argument '" + $1.name + "'");
        }

        // $$: 'LVAL' has a register pointing to that var's memory
        int dest_offset = sym.offset[sym.depth];
        int src_reg   = $3.RegNum;

        if (lvalType == float_) {
            // Convert I1 (base pointer) to a float register
            int floatBaseReg = currentScopeRegsNum++;
            buffer->emit("CITOF F" + to_string(floatBaseReg) + " I1");

            // Store the float value in memory
            buffer->emit("STORF F" + to_string(src_reg) + " F" + to_string(floatBaseReg) + " " + to_string(dest_offset));
        } else if (lvalType == int_) {
            // Store the integer value in memory
            buffer->emit("STORI I" + to_string(src_reg) + " I1 " + to_string(dest_offset));
        }
        $$.type = lvalType;
        $$.RegNum = $1.RegNum;
        }
;

LVAL:
    ID
    {
        $$.name = $1.name;
        $$.quad = buffer->nextQuad();

        // Check if the variable is defined
        if (symbolTable.find($1.name) == symbolTable.end()) {
            printSemanticError("undefined variable '" + $1.name + "'");
        }

        Symbol& sym = symbolTable[$1.name];

        // Check if the variable is defined in the current scope
        if (sym.type.find(sym.depth) == sym.type.end()) {
            printSemanticError("undefined variable '" + $1.name + "' at current scope");
        }
    }
;

CNTRL_STMT:
    IF BEXP THEN M STMT ELSE N M STMT
    {
        $$.quad = buffer->nextQuad();
        // Backpatch the true and false lists of the boolean expression to the appropriate jump targets
        buffer->backpatch($2.trueList, $4.quad);
        buffer->backpatch($2.falseList, $8.quad);
        // Merge the 'next lists' of the two statements and the 'N' non-terminal into the control statement's 'next list'
		$$.nextList = merge<int>($5.nextList, $7.nextList);
		$$.nextList = merge<int>($$.nextList, $9.nextList);
		$5.nextList.clear();
		$9.nextList.clear();
		$7.nextList.clear();
    }
    | IF BEXP THEN M STMT
    {
        // Backpatch the true list of the boolean expression to the statement's quad
        buffer->backpatch($2.trueList, $4.quad);
        // Merge the false list of the boolean expression and the 'next list' of the statement into
        // the control statement's 'next list'
		$$.nextList = merge<int>($2.falseList, $5.nextList);
		$2.falseList.clear();
		$5.nextList.clear();
    }
    | WHILE M BEXP DO M STMT
    {
        // Backpatch the true list of the boolean expression to the statement's quad
		buffer->backpatch($3.trueList, $5.quad);
        // Backpatch the 'next list' of the statement to the beginning of the loop (M's quad)
		buffer->backpatch($6.nextList, $2.quad);
        // The false list of the boolean expression becomes the 'next list' of the control statement
		$$.nextList = $3.falseList;
        // Emit an unconditional jump to the beginning of the loop
		buffer->emit("UJUMP " + intToString($2.quad));
	}
;

BEXP:
    BEXP OR M BEXP
    {
        // Backpatch the false list of the left-hand side boolean expression to the quad of the marker 'M'
        buffer->backpatch($1.falseList, $3.quad);
        // The false list of the overall expression is the false list of the right-hand side expression
		$$.falseList = $4.falseList;
        // Merge the true lists of both sides into the true list of the overall expression
		$$.trueList = merge($1.trueList, $4.trueList);
		$1.trueList.clear();
		$4.trueList.clear();
    }
    | BEXP AND M BEXP
    {
        // Backpatch the true list of the left-hand side boolean expression to the quad of the marker 'M'
        buffer->backpatch($1.trueList, $3.quad);
        // The true list of the overall expression is the true list of the right-hand side expression
		$$.trueList = $4.trueList;
        // Merge the false lists of both sides into the false list of the overall expression
		$$.falseList = merge<int>($1.falseList, $4.falseList);
		$1.falseList.clear();
		$4.falseList.clear();
    }
    | NOT BEXP
    {
        // The true list of the overall expression is the false list of the subexpression, and vice-versa
        $$.trueList = $2.falseList;
        $$.falseList = $2.trueList;
    }
    | EXP RELOP EXP
    {
        // Check for type mismatches in relational expressions
        if ($1.type != $3.type) {
            printSemanticError("type mismatch in relational expression");
        } else if ($1.type == void_t) {
			printSemanticError("can't perform this operation on 'void' type arguments");
        }

        $$.RegNum = currentScopeRegsNum++;
        string opName;

        // Determine the appropriate comparison instruction based on the operator
        if ($2.name == "==")       opName = "SEQU";
        else if ($2.name == "<>")  opName = "SNEQ";
        else if ($2.name == "<=" || $2.name == ">")  opName = "SGRT"; 
        else if ($2.name == ">=" || $2.name == "<")  opName = "SLET"; 
        else printSemanticError("Invalid relative operator.");

        if ($1.type == float_) {
            // Perform floating-point comparison
            int cmpFloatReg = currentScopeRegsNum++;
            buffer->emit(opName + "F F" + to_string(cmpFloatReg)
                        + " F" + to_string($1.RegNum)
                        + " F" + to_string($3.RegNum));

            // Convert the comparison result to an integer
            buffer->emit("CFTOI I" + to_string($$.RegNum) +
                        " F" + to_string(cmpFloatReg));
        } else {
            // Perform integer comparison
            buffer->emit(opName + "I I" + to_string($$.RegNum)
                        + " I" + to_string($1.RegNum)
                        + " I" + to_string($3.RegNum));
        }

        // Prepare for conditional jump based on the comparison result
        $$.falseList.push_back(buffer->nextQuad());
        if ($2.name == "<>" || $2.name == "==" ||
            $2.name == "<"  || $2.name == ">")
        {
            // Branch if result==0
            buffer->emit("BREQZ I" + to_string($$.RegNum) + " ");
        }
        else {
            // Branch if result!=0
            buffer->emit("BNEQZ I" + to_string($$.RegNum) + " ");
        }

        // Prepare for unconditional jump after the conditional branch
        $$.trueList.push_back(buffer->nextQuad());
        buffer->emit("UJUMP ");
    }
    | LPAREN BEXP RPAREN
    {
        // Inherit the true and false lists from the parenthesized boolean expression
        $$.trueList = $2.trueList;
        $$.falseList = $2.falseList;
    }
;

EXP:
    EXP ADDOP EXP
    {
        $$.quad = buffer->nextQuad();

        // Check for void types in arithmetic expressions
        if ($1.type == void_t || $3.type == void_t) {
            printSemanticError("void type in arithmetic expression");
        }
        // Check for type mismatches in arithmetic expressions
        if ($1.type != $3.type) {
            printSemanticError("mismatch in types between arithmetic operators");
        }

        // Determine the register type and operation name based on the type and operator
        string regType = ($$.type == float_) ? "F" : "I"; 
        string opName = ($2.name == "+") ? "ADD2" : "SUBT"; 
        $$.type = $1.type;
        $$.RegNum = currentScopeRegsNum++;

        // Emit the arithmetic operation instruction
        int reg1 = $1.RegNum;
        int reg2 = $3.RegNum;
        buffer->emit(opName + regType + " " + regType + to_string($$.RegNum) +  
            " " + regType + to_string(reg1) +                           
            " " + regType + to_string(reg2));
    }
    | EXP MULOP EXP
    {
        $$.quad = buffer->nextQuad();

        // Check for void types in arithmetic expressions
        if ($1.type == void_t || $3.type == void_t) {
            printSemanticError("void type in arithmetic expression");
        }
        // Check for type mismatches in arithmetic expressions
        if ($1.type != $3.type)
        {
            printSemanticError("mismatch in types between arithmetic operators");
        }

        // Determine the register type and operation name based on the type and operator
        string regType = ($$.type == float_) ? "F" : "I";
        string opName = ($2.name == "*") ? "MULT" : "DIVD";
        $$.type = ($1.type == float_ || $3.type == float_) ? float_ : int_;
        $$.RegNum = currentScopeRegsNum++;

        // Emit the arithmetic operation instruction
        int reg1 = $1.RegNum;
        int reg2 = $3.RegNum;
        buffer->emit(opName + regType + " " + regType + to_string($$.RegNum) +
            " " + regType + to_string(reg1) +
            " " + regType + to_string(reg2));
    }
    | LPAREN EXP RPAREN
    {
        // Inherit the properties of the parenthesized expression
        $$ = $2;
    }
    | LPAREN TYPE RPAREN EXP
    {
        // Check for invalid casting to/from void
        if ($2.type == void_t && $4.type != void_t) {  
            printSemanticError("can't cast a non-void expression to void");
        } else if ($2.type != void_t && $4.type == void_t) {
            printSemanticError("can't perform this operation on 'void' type argument");
        }
        $$.type = $2.type;
        $$.RegNum = currentScopeRegsNum++;

        // Emit the appropriate type conversion instruction based on the source and target types
        if ($2.type == float_ && $4.type == int_) {
            buffer->emit(string("CITOF F") + to_string($$.RegNum) + string(" I") +
                                to_string($4.RegNum));

        } else if ($2.type == int_ && $4.type == float_) {
            buffer->emit(string("CFTOI I") + to_string($$.RegNum) + string(" F") + 
                                to_string($4.RegNum));

        } else {
            // If no conversion is needed, emit a copy instruction (if types are different) or do nothing (if types are the same)
            if ($2.type == float_) {
                buffer->emit(string("COPYF F") + to_string($$.RegNum) + string(" F") +
                                     to_string($4.RegNum));

            } else {
                buffer->emit(string("COPYI I") + to_string($$.RegNum) + string(" I") + 
                                     to_string($4.RegNum));
            }
        }
    }
    | ID
    {
        // Check if the identifier is defined
        if (symbolTable.find($1.name) == symbolTable.end()) {
            printSemanticError("unDefined variable '" + $1.name + "'");
        }

        Symbol& sym = symbolTable[$1.name];
        // Check if the identifier is defined in the current scope
        if (sym.type.find(sym.depth) == sym.type.end()) {
            printSemanticError("unDefined variable '" + $1.name + "' at current scope");
        }

        $$.type = sym.type[sym.depth];
        $$.RegNum = currentScopeRegsNum++;
        $$.name = $1.name;

        // Emit code to load the value of the identifier into a register
        if ($$.type == float_) {
            int floatBaseReg = currentScopeRegsNum++;
            buffer->emit("CITOF F" + to_string(floatBaseReg) + " I1");  // Convert I1 to F
            buffer->emit("LOADF F" + to_string($$.RegNum) + " F" + to_string(floatBaseReg) + " " +
                         to_string(sym.offset[sym.depth]));
        } else {
            buffer->emit(string("LOADI I") + 
                         to_string($$.RegNum) + string(" I1 ") +
                         to_string(sym.offset[sym.depth]));
        }
    }       
    | NUM
    {
        // Set the type and value of the numeric literal
        $$.type = ($1.type == int_) ? int_ : float_; 
        $$.RegNum = currentScopeRegsNum++; 
        $$.name = $1.name; 

        // Emit code to copy the numeric literal into a register
        if ($$.type == float_) {
            buffer->emit("COPYF F" + to_string($$.RegNum) + " " + $1.name);
        } else { 
            buffer->emit("COPYI I" + to_string($$.RegNum) + " " + $1.name); 
        }
    }
    | CALL
    {
        // Inherit the properties of the function call
        $$ = $1;
    }
    | VA_MATERIALISE
    {
        // Inherit the properties of the va_arg expression
        $$ = $1;
    }
;

NUM:
    INTEGERNUM
    {
        // Set the type to 'int' for integer literals
        $$.type = int_;
        $$.quad = buffer->nextQuad();
    }
    | REALNUM
    {
        // Set the type to 'float' for real number literals
        $$.type = float_;
        $$.quad = buffer->nextQuad();
    }
;

CALL:
    ID LPAREN CALL_ARGS RPAREN
    {
        // --- Function Call Handling ---
        
        // Check if the function being called is defined
        if (functionTable.find($1.name) == functionTable.end()) {
            printSemanticError("Undefined function '" + $1.name + "'");
        }
        Function &func = functionTable[$1.name];

        // --- Argument Validation ---

        // Check if the number of arguments matches the function definition (for non-variadic functions)
        if (func.indexNumVAParams == -1) { // Check if it's not a variadic function
            if (func.paramTypes.size() != $3.paramTypes.size()) {
                printSemanticError("incorrect number of arguments of function '" + $1.name + "'");
            }
        } 
        
        // Check if the types of arguments match the function definition
        for (int i = 0; i < (int)func.paramTypes.size(); i++) {
            if (func.paramTypes[i] != $3.paramTypes[i]) {
                printSemanticError("incompatible argument type for function '" + $1.name + "'");
            }
        }
    
        // --- Stack Management (Before Call) ---

        // Align the stack if needed to ensure 4-byte alignment
        int shiftSize = 0;
        if (current_param_offset % 4 != 0) {
            shiftSize = 4 - (current_param_offset % 4);
            buffer->emit("ADD2I I2 I2 " + to_string(shiftSize));
            current_param_offset += shiftSize;
        }

        // Save all caller registers on the stack before the function call
        int totalBytesPushed = 0;
        int floatBaseReg = currentScopeRegsNum++; // Temporary float base register for float operations
        buffer->emit("CITOF F2 I2"); // Convert I2 (stack pointer) to F2 for float operations
        for (int regID = 0; regID < currentScopeRegsNum; regID++) {
            buffer->emit("STORI I" + to_string(regID) + " I2 " + to_string(totalBytesPushed));
            buffer->emit("STORF F" + to_string(regID) + " F2 " + to_string(totalBytesPushed));
            totalBytesPushed += 4; 
        }
        totalBytesPushed += 4; 

        // --- Parameter Passing ---

        // Store parameters on the stack
        vector<Type> callArgTypes = $3.paramTypes; 
        vector<int>  callArgRegs  = $3.paramRegs;  
        $3.paramRegs.clear(); // Clear paramRegs after storing them
		$3.paramTypes.clear(); // Clear paramTypes after storing them

        // Adjust the stack pointer (I2) to account for the space reserved for saved registers and parameters
        buffer->emit("ADD2I I2 I2 " + to_string(totalBytesPushed));
        buffer->emit("ADD2F F2 F2 " + to_string(totalBytesPushed));
        current_param_offset += totalBytesPushed;

        // Set the frame pointer (I1) to the current stack pointer (I2)
        buffer->emit("COPYI I1 I2");
        buffer->emit("CITOF F1 I1");
    

        for (size_t i = 0; i < callArgTypes.size(); i++) {
            int finalReg = callArgRegs[i];
            Type paramType = callArgTypes[i];

            // Calculate the offset for each parameter on the stack
            int paramOffset = -8 - (i * 4);

            if (paramType == float_) {
                buffer->emit("STORF F" + to_string(finalReg) + " F1 " + to_string(paramOffset));
            } else {
                buffer->emit("STORI I" + to_string(finalReg) + " I1 " + to_string(paramOffset));
            }
        }

        // --- Function Call ---

        // Store the calling line number for later backpatching in case the function is not yet defined
        functionTable[$1.name].callingLines.push_back(buffer->nextQuad());
        buffer->emit("JLINK ");

        // --- Stack Management (After Call) ---

        // After the function call, restore the stack frame by setting the stack pointer (I2) to the frame pointer (I1)
        buffer->emit("COPYI I2 I1");
        buffer->emit("CITOF F2 I2");

        // --- Return Value Handling ---

        // Load the return value from the stack if the function is not void
        $$.type = func.returnType;
        $$.RegNum = currentScopeRegsNum++;
        if ($$.type != void_t) {
            if ($$.type == float_) {
                buffer->emit("LOADF F" + to_string($$.RegNum) + " F1 -4");
            } else {
                buffer->emit("LOADI I" + to_string($$.RegNum) + " I1 -4");
            }
        }

        // --- Stack Deallocation ---

        // Deallocate the space added to the stack for saved registers and parameters
        buffer->emit("SUBTI I2 I2 " + to_string(totalBytesPushed));
        buffer->emit("SUBTF F2 F2 " + to_string(totalBytesPushed));

        // --- Register Restoration ---
        
        // Restore all caller registers from the stack after the function call
        int restoreOffset = 0;
        for (int regID = 0; regID < currentScopeRegsNum; regID++) {
            // Skip I2 (stack pointer) as it was already restored
            if (regID == 2) {
                restoreOffset +=4;
                continue;
            }
            buffer->emit("LOADI I" + to_string(regID) +
                         " I2 " + to_string(restoreOffset));
            buffer->emit("LOADF F" + to_string(regID) + " F2 " + to_string(restoreOffset));
            restoreOffset += 4;
        }
        currentScopeRegsNum++;	// Increment the register counter after using registers in this scope
    }
;

VA_MATERIALISE:
    VA_ARG LPAREN TYPE COMMA EXP RPAREN
    {
        $$.quad = buffer->nextQuad();
        $$.type = $3.type;
        $$.RegNum = currentScopeRegsNum++;
        std::vector<int> runtime_errors;

        // Check if va_arg is used within a variadic function
        if (!inVariadicFunction) {
            printSemanticError("va_arg found in non-variadic function");
        }

        // Get n (offset to n was saved in I3 in function definition).
        int num_va_params_reg = currentScopeRegsNum++;
        buffer->emit("LOADI I" + to_string(num_va_params_reg) + " I1 I3");

        // Runtime check: 0 <= index < n
        int tempReg1 = currentScopeRegsNum++;
        int tempReg2 = currentScopeRegsNum++;

        // Check (index >= 0)
        buffer->emit("SLETI I" + to_string(tempReg1) + " I" + to_string($5.RegNum) + " 0");
        runtime_errors.push_back(buffer->nextQuad());
        buffer->emit("BNEQZ I" + to_string(tempReg1) + " "); // Jump if index < 0

        // Check (index < n)
        buffer->emit("SLETI I" + to_string(tempReg2)
             + " I" + to_string($5.RegNum)
                        + " I" + to_string(num_va_params_reg));
        runtime_errors.push_back(buffer->nextQuad());
        buffer->emit("BREQZ I" + to_string(tempReg2) + " "); // Jump if index >= n

        int temp_reg_3 = currentScopeRegsNum++;
        int va_param_offset = currentScopeRegsNum++;
        // Get index of argument, turn it into offset.
        buffer->emit("ADD2I I" + to_string(temp_reg_3) + " I" + to_string($5.RegNum) + " 1");
        buffer->emit("MULTI I" + to_string(temp_reg_3) + " I" + to_string(temp_reg_3) + " 4");
        buffer->emit("SUBTI I" + to_string(va_param_offset) + " I3 I" + to_string(temp_reg_3));

        // Load the variadic argument based on its type
        if (int_ == $3.type) {
            buffer->emit("LOADI I" + to_string($$.RegNum) + " I1 I" + to_string(va_param_offset));
        } else if (float_ == $3.type) {
            buffer->emit("CITOF F1 I1");
            buffer->emit("CITOF F" + to_string(va_param_offset) + " I" + to_string(va_param_offset));
            buffer->emit("LOADF F" + to_string($$.RegNum) + " F1 F" + to_string(va_param_offset));
        } else {
            printSemanticError("Invalid type for variadic argument");
        }

        // Error handling block: print "Runtime error!" and halt
        int runtime_error_skip = buffer->nextQuad();
        buffer->emit("UJUMP ");
        int runtime_error_print = buffer->nextQuad();
        buffer->emit("PRNTC 82");   // R
        buffer->emit("PRNTC 117");  // u
        buffer->emit("PRNTC 110");  // n
        buffer->emit("PRNTC 116");  // t
        buffer->emit("PRNTC 105");  // i
        buffer->emit("PRNTC 109");  // m
        buffer->emit("PRNTC 101");  // e
        buffer->emit("PRNTC 32");   //
        buffer->emit("PRNTC 101");  // e
        buffer->emit("PRNTC 114");  // r
        buffer->emit("PRNTC 114");  // r
        buffer->emit("PRNTC 111");  // o
        buffer->emit("PRNTC 114");  // r
        buffer->emit("PRNTC 33");   // !
        buffer->emit("PRNTC 10");   // \n
        buffer->emit("HALT");
        // Backpatch jump instructions for runtime errors to the error handling block
        buffer->backpatch(runtime_errors, runtime_error_print);
        $$.nextList.push_back(runtime_error_skip); // Skip if nothing bad happened.
        buffer->backpatch($$.nextList, buffer->nextQuad());
    }
;

CALL_ARGS:
    CALL_ARGLIST
    {
        // Inherit parameter types and registers from the argument list
		$$.paramTypes = $1.paramTypes;	
		$$.paramRegs = $1.paramRegs;
		$1.paramTypes.clear();
		$1.paramRegs.clear();      
    }
    | /* empty */ { }
;

CALL_ARGLIST:
    CALL_ARGLIST COMMA EXP
    {
        // Propagate parameter types and registers, and add the new expression's type and register
        $$.paramTypes = $1.paramTypes;
        $$.paramRegs = $1.paramRegs;
        $$.paramTypes.push_back($3.type);
        $$.paramRegs.push_back($3.RegNum);
        $1.paramTypes.clear();
	    $1.paramRegs.clear();
    }
    | EXP
    {
        // Base case: add the expression's type and register to the lists
        $$.paramTypes.push_back($1.type);
        $$.paramRegs.push_back($1.RegNum);
    }
;

M :
    /* EPSILON */
    {
        // Set the quad to the next available quad, marking a location in the code
        $$.quad = buffer->nextQuad();
    }
;

N :
    /* EPSILON */
    {
        // Add the next quad to the 'next list' and emit an unconditional jump instruction (for later backpatching)
        $$.nextList.push_back(buffer->nextQuad());
        buffer->emit("UJUMP ");
    }
;
%%

int main(int argc, char* argv[]) {
    // Check number of arguments
    if (argc != 2) {
        cerr << "Operational error: invalid number of arguments" << endl;
        exit(OPERATIONAL_ERROR);
    }

    string inputFileName = argv[1];

    // Check file extension
    size_t lastindex = inputFileName.find_last_of(".");
    if (lastindex == string::npos || inputFileName.substr(lastindex) != ".cmm") {
        cerr << "Operational error: invalid file type. expecting '.cmm' extension" << endl;
        exit(OPERATIONAL_ERROR);
    }

    // Open input file
    extern FILE* yyin;
    yyin = fopen(argv[1], "r");
    if (yyin == NULL) {
        cerr << "Operational error: cannot open input file" << endl;
        exit(OPERATIONAL_ERROR);
    }

    // Initialize buffer
    buffer = new Buffer();

    // Parse input
    if (yyparse() != 0) {
        // Error handling is done in yyerror
        fclose(yyin);
        yylex_destroy();
        delete buffer;
        return 1;
    }

    // Generate header
    string header = "<header>\n";

    // Generate unimplemented functions list
    string uimp = "<unimplemented>";
    for (const auto& func : functionTable) {
        if (func.second.startLineImplementation == -1) {
            uimp += " " + func.first;
            for (int line : func.second.callingLines) {
                uimp += "," + to_string(line);
            }
        }
    }
    header += uimp + "\n";

    // Generate implemented functions list
    string imp = "<implemented>";
    for (const auto& func : functionTable) {
        if (func.second.startLineImplementation != -1) {
            imp += " " + func.first + "," + to_string(func.second.startLineImplementation);
        }
    }
    header += imp + "\n";
    header += "</header>";

    // Add header to beginning of buffer
    buffer->frontEmit(header);

    // Generate output file name
    string outputFileName = inputFileName.substr(0, lastindex) + ".rsk";
    size_t found = outputFileName.find_last_of("/\\");
    if (found != string::npos) {
        outputFileName = outputFileName.substr(found + 1);
    }

    // Write to output file
    ofstream rskFile(outputFileName);
    if (!rskFile.is_open()) {
        cerr << "Operational error: cannot create output file" << endl;
        fclose(yyin);
        yylex_destroy();
        delete buffer;
        exit(OPERATIONAL_ERROR);
    }

    rskFile << buffer->printBuffer();
    rskFile.close();
    fclose(yyin);
    yylex_destroy();

    delete buffer;
    return 0;
}

void yyerror(const char *s) {
    cerr << "Syntax error: '" << yytext << "' in line number " << yylineno << endl;
    exit(SYNTAX_ERROR);
}

int printOperationalError (string err) {
    cerr << "Operational error: " << err << endl;
    exit(OPERATIONAL_ERROR);
}

int printSemanticError (string err) {
    cerr << "Semantic error: " << err << " in line number " << yylineno << endl;
    exit(SEMANTIC_ERROR);
}